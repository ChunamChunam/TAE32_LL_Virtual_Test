<UserControl x:Class="TAE32.LLVirtualTest.App.Views.Pages.RegisterManagementPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="2*"/>
      <RowDefinition Height="1.2*"/>
    </Grid.RowDefinitions>

    <StackPanel Margin="0,0,0,10">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="解析寄存器" Command="{Binding ParseRegistersCommand}" Margin="8,0,0,0"/>
        <Button DockPanel.Dock="Right" Content="查询" Command="{Binding SearchCommand}" Margin="8,0,0,0"/>
        <TextBlock Text="寄存器管理" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
      </DockPanel>
      <DockPanel Margin="0,8,0,0">
        <CheckBox DockPanel.Dock="Right" Content="隐藏保留位 RESERVED" IsChecked="{Binding HideReserved}"
                  VerticalAlignment="Center" Margin="8,0,0,0"/>
        <ComboBox DockPanel.Dock="Right" Width="140" DisplayMemberPath="Name"
                  ItemsSource="{Binding InstanceFilters}" SelectedItem="{Binding SelectedInstance}"
                  ToolTip="外设实例（如 GPIOA / ADC0）" Margin="8,0,0,0"/>
        <ComboBox DockPanel.Dock="Right" Width="120" DisplayMemberPath="Name"
                  ItemsSource="{Binding PeripheralFilters}" SelectedItem="{Binding SelectedPeripheral}"
                  ToolTip="外设模块（如 GPIO / ADC）" Margin="8,0,0,0"/>
        <ComboBox DockPanel.Dock="Right" Width="120" DisplayMemberPath="ModelName"
                  ItemsSource="{Binding ChipFilters}" SelectedItem="{Binding SelectedChip}"
                  ToolTip="芯片" Margin="8,0,0,0"/>
        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="搜索寄存器名 / 结构体名 / 实例名"/>
      </DockPanel>
      <TextBlock Margin="0,6,0,0" Foreground="{StaticResource BrushAccent}" Text="{Binding ParseSummaryText}" TextWrapping="Wrap"/>
      <TextBlock Margin="0,4,0,0" Foreground="{StaticResource BrushTextMuted}" Text="{Binding EmptyHint}" TextWrapping="Wrap"/>
    </StackPanel>

    <Border Grid.Row="1" Style="{StaticResource AppCardBorderStyle}" Margin="0,0,0,10" Padding="0">
      <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource GridPagerFooterStyle}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="每页" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <ComboBox Width="72" ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding PageSize}" VerticalAlignment="Center"/>
              <TextBlock Text="条" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="首页" Command="{Binding FirstPageCommand}" Margin="0,0,6,0"/>
              <Button Content="上一页" Command="{Binding PreviousPageCommand}" Margin="0,0,6,0"/>
              <Button Content="下一页" Command="{Binding NextPageCommand}" Margin="0,0,6,0"/>
              <Button Content="末页" Command="{Binding LastPageCommand}"/>
            </StackPanel>
            <TextBlock Text="{Binding PageInfoText}" Foreground="{StaticResource BrushTextPrimary}"
                       VerticalAlignment="Center" Margin="8,0,0,0"/>
          </DockPanel>
        </Border>
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedRegister}"
                  AutoGenerateColumns="False" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="寄存器" Binding="{Binding Register.MemberName}" Width="120"/>
            <DataGridTextColumn Header="结构体" Binding="{Binding Register.StructName}" Width="140"/>
            <DataGridTextColumn Header="外设" Binding="{Binding ModuleName}" Width="80"/>
            <DataGridTextColumn Header="实例" Binding="{Binding InstanceName}" Width="80"/>
            <DataGridTextColumn Header="偏移" Binding="{Binding OffsetText}" Width="70"/>
            <DataGridTextColumn Header="偏移状态" Binding="{Binding Register.OffsetStatus}" Width="100"/>
            <DataGridTextColumn Header="绝对地址" Binding="{Binding AbsoluteAddressText}" Width="110"/>
            <DataGridTextColumn Header="宽度" Binding="{Binding Register.WidthBits}" Width="50"/>
            <DataGridTextColumn Header="访问" Binding="{Binding Register.AccessAttribute}" Width="70"/>
            <DataGridTextColumn Header="解析状态" Binding="{Binding Register.ParseStatus}" Width="80"/>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Border>

    <Border Grid.Row="2" Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}"
            BorderThickness="1" CornerRadius="8" Padding="14">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding DetailMeta}" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TabControl>
          <TabItem Header="字段">
            <TextBox Style="{StaticResource MonospaceReadOnlyTextBoxStyle}" Text="{Binding DetailFields, Mode=OneWay}"/>
          </TabItem>
          <TabItem Header="宏引用">
            <TextBox Style="{StaticResource MonospaceReadOnlyTextBoxStyle}" Text="{Binding DetailMacros, Mode=OneWay}"/>
          </TabItem>
          <TabItem Header="诊断">
            <TextBox Style="{StaticResource MonospaceReadOnlyTextBoxStyle}" Text="{Binding DetailDiagnostics, Mode=OneWay}"/>
          </TabItem>
        </TabControl>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
