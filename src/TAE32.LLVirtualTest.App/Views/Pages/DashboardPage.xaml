<UserControl x:Class="TAE32.LLVirtualTest.App.Views.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,8,24" HorizontalAlignment="Stretch">

      <Border Style="{StaticResource AppCardBorderStyle}" Margin="0,0,0,16">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="工作台" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource BrushTextMuted}"
                       Text="主数字来自 SQLite 已导入数据；结构基线见 KnowledgeBase，仅作对照。"/>
            <StackPanel Margin="0,10,0,0">
              <StackPanel Orientation="Horizontal">
                <Border Background="#FF1A2E28" BorderBrush="{StaticResource BrushAccent}" BorderThickness="1"
                        CornerRadius="4" Padding="10,4" Margin="0,0,10,0" VerticalAlignment="Center">
                  <TextBlock FontSize="11" Foreground="{StaticResource BrushAccent}"
                             Text="TAE32G58xx · Phase 7"/>
                </Border>
                <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushTextPrimary}" Text="{Binding LiveStatsLine}"/>
              </StackPanel>
              <TextBlock Margin="0,6,0,0" FontSize="11" Text="{Binding BaselineNoteText}"
                         ToolTip="{Binding BaselineTooltip}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding MatchesBaseline}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </StackPanel>
          <Button Grid.Column="1" VerticalAlignment="Top"
                  Style="{StaticResource GhostButtonStyle}"
                  Content="刷新数据" Command="{Binding RefreshCommand}"/>
        </Grid>
      </Border>

      <TextBlock Style="{StaticResource DashboardSectionTitleStyle}" Text="项目概览"/>
      <Grid Margin="0,0,0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource DashboardKpiCardStyle}" Margin="0,0,10,12">
          <Grid>
            <Border Width="3" HorizontalAlignment="Left" Background="{StaticResource BrushAccent}" CornerRadius="8,0,0,8"/>
            <StackPanel Margin="16,14,14,14">
              <TextBlock Style="{StaticResource DashboardKpiLabelStyle}" Text="SDK 项目"/>
              <TextBlock Style="{StaticResource DashboardKpiValueStyle}" Text="{Binding SdkProjectCount}"/>
              <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Text="DFP / 扫描工程"/>
            </StackPanel>
          </Grid>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource DashboardKpiCardStyle}" Margin="0,0,10,12">
          <Grid>
            <Border Width="3" HorizontalAlignment="Left" Background="{StaticResource BrushAccent}" CornerRadius="8,0,0,8"/>
            <StackPanel Margin="16,14,14,14">
              <TextBlock Style="{StaticResource DashboardKpiLabelStyle}" Text="芯片型号"/>
              <TextBlock Style="{StaticResource DashboardKpiValueStyle}" Text="{Binding ChipCount}"/>
              <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Text="当前库内芯片记录"/>
            </StackPanel>
          </Grid>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource DashboardKpiCardStyle}" Margin="0,0,0,12">
          <Grid>
            <Border Width="3" HorizontalAlignment="Left" Background="{StaticResource BrushAccent}" CornerRadius="8,0,0,8"/>
            <StackPanel Margin="16,14,14,14">
              <TextBlock Style="{StaticResource DashboardKpiLabelStyle}" Text="外设模块"/>
              <TextBlock Style="{StaticResource DashboardKpiValueStyle}" Text="{Binding PeripheralCount}"/>
              <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Text="含 CORTEX，不含 ll.h 公共头"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <TextBlock Style="{StaticResource DashboardSectionTitleStyle}" Text="LL 与导入状态" Margin="0,8,0,0"/>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.15*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource AppCardBorderStyle}" Margin="0,0,10,12" Padding="16">
          <StackPanel>
            <TextBlock Text="LL 函数规模" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource DashboardKpiLabelStyle}" Text="全形式（含宏/声明等）"/>
                <TextBlock Style="{StaticResource DashboardKpiValueStyle}" FontSize="28"
                           Foreground="{StaticResource BrushAccent}" Text="{Binding LlFunctionCount}"/>
              </StackPanel>
              <Border Grid.Column="1" Width="1" Margin="8,4" Background="{StaticResource BrushBorder}"/>
              <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource DashboardKpiLabelStyle}" Text="Inline 定义（测试主口径）"/>
                <TextBlock Style="{StaticResource DashboardKpiValueStyle}" FontSize="28"
                           Foreground="{StaticResource BrushAccent}" Text="{Binding InlineFunctionCount}"/>
              </StackPanel>
            </Grid>
            <TextBlock Margin="0,12,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource BrushTextMuted}"
                       Text="自动化测试与用例生成默认面向 inline 定义；函数库页可查看全形式与解析深度。"/>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource AppCardBorderStyle}" Margin="0,0,0,12" Padding="16">
          <StackPanel>
            <TextBlock Text="扫描与导入" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
            <TextBlock Margin="0,12,0,0" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{StaticResource BrushTextPrimary}" Text="{Binding ScanStatusText}"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <TextBlock Foreground="{StaticResource BrushTextMuted}" FontSize="12" Text="最近导入　"/>
              <TextBlock Foreground="{StaticResource BrushAccent}" FontSize="12" Text="{Binding LastImportText}"/>
            </StackPanel>
            <Border Margin="0,14,0,0" Background="{StaticResource BrushBgInput}" CornerRadius="6" Padding="10,8">
              <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource BrushTextMuted}"
                         Text="启动时若已有数据将跳过自动扫描。需重新生成 JSON 时请打开「SDK 管理」执行扫描。"/>
            </Border>
          </StackPanel>
        </Border>
      </Grid>

      <TextBlock Style="{StaticResource DashboardSectionTitleStyle}" Text="常用流程" Margin="0,4,0,0"/>
      <Border Style="{StaticResource AppCardBorderStyle}" Padding="16,14">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Margin="0,0,12,0">
            <DockPanel Margin="0,0,0,12">
              <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="11"
                      Background="{StaticResource BrushAccentSoft}" Margin="0,0,10,0">
                <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold"/>
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock FontWeight="SemiBold" Text="SDK 管理"/>
                <TextBlock FontSize="11" Foreground="{StaticResource BrushTextMuted}" Text="确认工程、扫描并导入基线数据"/>
              </StackPanel>
            </DockPanel>
            <DockPanel Margin="0,0,0,12">
              <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="11"
                      Background="{StaticResource BrushAccentSoft}" Margin="0,0,10,0">
                <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold"/>
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock FontWeight="SemiBold" Text="LL 函数库 / 寄存器"/>
                <TextBlock FontSize="11" Foreground="{StaticResource BrushTextMuted}" Text="深度解析、核对寄存器与外设实例"/>
              </StackPanel>
            </DockPanel>
          </StackPanel>

          <StackPanel Grid.Column="1">
            <DockPanel Margin="0,0,0,12">
              <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="11"
                      Background="{StaticResource BrushAccentSoft}" Margin="0,0,10,0">
                <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold"/>
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock FontWeight="SemiBold" Text="自动化测试"/>
                <TextBlock FontSize="11" Foreground="{StaticResource BrushTextMuted}" Text="勾选函数生成用例、隔离进程执行"/>
              </StackPanel>
            </DockPanel>
            <DockPanel>
              <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="11"
                      Background="{StaticResource BrushAccentSoft}" Margin="0,0,10,0">
                <TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold"/>
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock FontWeight="SemiBold" Text="测试管理"/>
                <TextBlock FontSize="11" Foreground="{StaticResource BrushTextMuted}" Text="计划批跑、历史统计与报告导出"/>
              </StackPanel>
            </DockPanel>
          </StackPanel>
        </Grid>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
