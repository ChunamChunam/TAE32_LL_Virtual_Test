<UserControl x:Class="TAE32.LLVirtualTest.App.Views.Pages.ChipManagementPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock Text="芯片管理" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
      <TextBlock Text="来源：第一阶段 03_ChipDiscovery.json（人工确认基线）" Foreground="{StaticResource BrushTextMuted}"/>
      <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="型号 / 识别状态 / SDK 路径" Margin="0,0,8,0"/>
        <ComboBox Grid.Column="1" Width="120" Margin="0,0,8,0"
                  ItemsSource="{Binding StatusFilterOptions}"
                  SelectedItem="{Binding SelectedStatusFilter}"
                  ToolTip="按识别状态筛选"/>
        <Button Grid.Column="2" Style="{StaticResource GhostButtonStyle}" Content="查询" Margin="0,0,8,0"
                Command="{Binding SearchCommand}"/>
        <Button Grid.Column="3" Content="刷新" Command="{Binding RefreshCommand}" Width="90"/>
      </Grid>
    </StackPanel>
    <DataGrid ItemsSource="{Binding Items}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="芯片型号" Binding="{Binding ModelName}" Width="140"/>
        <DataGridTextColumn Header="级别" Binding="{Binding Level}" Width="80"/>
        <DataGridTextColumn Header="识别状态" Binding="{Binding DetectionStatus}" Width="90"/>
        <DataGridTextColumn Header="置信度" Binding="{Binding Confidence}" Width="70"/>
        <DataGridTextColumn Header="外设数" Binding="{Binding PeripheralCount}" Width="70"/>
        <DataGridTextColumn Header="函数数" Binding="{Binding FunctionCount}" Width="80"/>
        <DataGridTextColumn Header="SDK 路径" Binding="{Binding SdkPath}" Width="2*"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
