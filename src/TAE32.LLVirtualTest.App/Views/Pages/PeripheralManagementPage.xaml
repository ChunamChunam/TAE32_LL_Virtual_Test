<UserControl x:Class="TAE32.LLVirtualTest.App.Views.Pages.PeripheralManagementPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock Text="外设管理" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
      <DockPanel Margin="0,8,0,0">
        <Button DockPanel.Dock="Right" Content="搜索/刷新" Command="{Binding RefreshCommand}"/>
        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
      </DockPanel>
    </StackPanel>
    <DataGrid ItemsSource="{Binding Items}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="序号" Binding="{Binding SerialNumber}" Width="50"/>
        <DataGridTextColumn Header="外设" Binding="{Binding Name}" Width="100"/>
        <DataGridTextColumn Header="所属芯片" Binding="{Binding ChipName}" Width="110"/>
        <DataGridTextColumn Header="Inline 函数数" Binding="{Binding InlineFunctionCount}" Width="100"/>
        <DataGridTextColumn Header="实例" Binding="{Binding Instances}" Width="*"/>
        <DataGridTextColumn Header="相关文件" Binding="{Binding RelatedFiles}" Width="2*"/>
        <DataGridTextColumn Header="状态" Binding="{Binding DetectionStatus}" Width="80"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
