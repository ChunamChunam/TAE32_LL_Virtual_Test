<UserControl x:Class="TAE32.LLVirtualTest.App.Views.Pages.SdkManagementPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource AppCardBorderStyle}" Margin="0,0,0,12">
      <Grid>
        <StackPanel>
          <TextBlock Text="SDK 管理" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
          <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource BrushTextMuted}"
                     Text="选择 SDK 目录 → 扫描源码生成 JSON → 导入 SQLite。移除项目不会删除磁盘上的原始 SDK。"/>
        </StackPanel>
        <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                Style="{StaticResource GhostButtonStyle}" Content="刷新列表"
                Command="{Binding RefreshCommand}"/>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="1.15*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource AppCardBorderStyle}" Padding="0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Margin="12,10,12,8" FontWeight="SemiBold"
                     Foreground="{StaticResource BrushTextPrimary}" Text="工程列表"/>
          <DataGrid ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="1.4*"/>
              <DataGridTextColumn Header="状态" Binding="{Binding ScanStatus}" Width="80"/>
              <DataGridTextColumn Header="最近导入" Binding="{Binding LastImportedAtUtc}" Width="130"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource AppCardBorderStyle}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="工程配置" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>

            <TextBlock Text="项目名称" Foreground="{StaticResource BrushTextMuted}" Margin="0,14,0,0" FontSize="12"/>
            <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/>

            <TextBlock Text="SDK 根路径（DFP 包或 LL 目录）" Foreground="{StaticResource BrushTextMuted}" Margin="0,12,0,0" FontSize="12"/>
            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0" Text="{Binding SdkRootPath, UpdateSourceTrigger=PropertyChanged}"
                       TextWrapping="Wrap" AcceptsReturn="True" MinHeight="44" VerticalScrollBarVisibility="Auto"/>
              <Button Grid.Column="1" Style="{StaticResource GhostButtonStyle}" Margin="8,0,0,0"
                      VerticalAlignment="Top" Content="浏览" Command="{Binding BrowseSdkCommand}"/>
            </Grid>

            <TextBlock Text="扫描 JSON 输出目录" Foreground="{StaticResource BrushTextMuted}" Margin="0,12,0,0" FontSize="12"/>
            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0" Text="{Binding ScanResultsPath, UpdateSourceTrigger=PropertyChanged}"
                       TextWrapping="Wrap" AcceptsReturn="True" MinHeight="44" VerticalScrollBarVisibility="Auto"/>
              <Button Grid.Column="1" Style="{StaticResource GhostButtonStyle}" Margin="8,0,0,0"
                      VerticalAlignment="Top" Content="浏览" Command="{Binding BrowseScanOutputCommand}"/>
            </Grid>

            <TextBlock Margin="0,16,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"
                       Text="操作"/>
            <WrapPanel Margin="0,10,0,0">
              <Button Content="扫描并生成 JSON" Command="{Binding ScanAndImportCommand}" Margin="0,0,6,6"/>
              <Button Content="仅导入 JSON" Command="{Binding ImportCommand}" Margin="0,0,6,6"/>
              <Button Content="保存路径" Command="{Binding SavePathsCommand}" Margin="0,0,6,6"/>
              <Button Content="移除项目" Command="{Binding RemoveCommand}" Margin="0,0,6,6"
                      Background="#FF6B3A3A"/>
            </WrapPanel>

            <Border Margin="0,16,0,0" Background="{StaticResource BrushBgInput}" CornerRadius="6" Padding="10,8"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
              <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource BrushAccent}" TextWrapping="Wrap"/>
            </Border>

            <TextBlock Margin="0,12,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource BrushTextMuted}"
                       Text="扫描会解析真实 .h/.c，生成 Chip / Peripheral / LL 函数 JSON，再写入本地数据库。"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>
