<UserControl x:Class="TAE32.LLVirtualTest.App.Views.Pages.LlFunctionLibraryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="2*"/>
      <RowDefinition Height="1.4*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource AppCardBorderStyle}" Margin="0,0,0,6">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="本页全选" Style="{StaticResource GhostButtonStyle}" Command="{Binding SelectPageCommand}" Margin="0,0,8,0"/>
          <Button Content="清空勾选" Style="{StaticResource GhostButtonStyle}" Command="{Binding ClearAllSelectionCommand}" Margin="0,0,8,0"/>
          <Button Content="解析勾选" Command="{Binding DeepParseSelectedCommand}" Margin="0,0,8,0"
                  ToolTip="深度解析已勾选函数；若未勾选则解析当前高亮行"/>
          <Button Content="深度解析全部" Command="{Binding DeepParseCommand}"
                  ToolTip="解析当前 SDK 全部 LL 头文件（耗时较长）"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="LL 函数库" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock Foreground="{StaticResource BrushAccent}" Text="{Binding ParseSummaryText}" TextWrapping="Wrap"/>
            <TextBlock Margin="16,0,0,0" Foreground="{StaticResource BrushTextMuted}" Text="{Binding CheckedCountText}"/>
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Grid.Row="1" Style="{StaticResource AppCardBorderStyle}" Margin="0,0,0,10" Padding="0">
      <DockPanel>
        <Border DockPanel.Dock="Top" Padding="10,8,10,6" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="函数名、文件名…" Margin="0,0,8,0"/>
              <ComboBox Grid.Column="1" Width="120" Margin="0,0,8,0"
                        ItemsSource="{Binding PeripheralFilters}" SelectedItem="{Binding SelectedPeripheral}"/>
              <ComboBox Grid.Column="2" Width="100" Margin="0,0,8,0"
                        ItemsSource="{Binding ChipFilters}" SelectedItem="{Binding SelectedChip}"/>
              <ComboBox Grid.Column="3" Width="100" Margin="0,0,8,0"
                        ItemsSource="{Binding FormFilters}" SelectedItem="{Binding SelectedForm}"/>
              <ComboBox Grid.Column="4" Width="100" Margin="0,0,8,0"
                        ItemsSource="{Binding ParseStatusFilterOptions}"
                        SelectedItem="{Binding SelectedParseStatusFilter}"
                        ToolTip="按解析状态筛选"/>
              <Button Grid.Column="5" Style="{StaticResource GhostButtonStyle}" Content="查询" Command="{Binding SearchCommand}"/>
            </Grid>
            <DockPanel Grid.Row="1" Margin="0,6,0,0">
              <CheckBox DockPanel.Dock="Right" Content="页全选" IsChecked="{Binding IsAllOnPageSelected}"
                        VerticalAlignment="Center" Margin="12,0,0,0"/>
              <TextBlock Foreground="{StaticResource BrushTextMuted}" Text="{Binding PageInfoText}" VerticalAlignment="Center"/>
            </DockPanel>
          </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource GridPagerFooterStyle}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="每页" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <ComboBox Width="72" ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding PageSize}" VerticalAlignment="Center"/>
              <TextBlock Text="条" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Style="{StaticResource GhostButtonStyle}" Content="首页" Command="{Binding FirstPageCommand}" Margin="0,0,6,0"/>
              <Button Style="{StaticResource GhostButtonStyle}" Content="上一页" Command="{Binding PreviousPageCommand}" Margin="0,0,6,0"/>
              <Button Style="{StaticResource GhostButtonStyle}" Content="下一页" Command="{Binding NextPageCommand}" Margin="0,0,6,0"/>
              <Button Style="{StaticResource GhostButtonStyle}" Content="末页" Command="{Binding LastPageCommand}"/>
            </StackPanel>
            <TextBlock Text="{Binding PageInfoText}" Foreground="{StaticResource BrushTextPrimary}"
                       VerticalAlignment="Center" Margin="8,0,0,0"/>
          </DockPanel>
        </Border>
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="" Width="36">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="函数名" Binding="{Binding FunctionName}" Width="1.6*"/>
            <DataGridTextColumn Header="芯片" Binding="{Binding ChipName}" Width="88"/>
            <DataGridTextColumn Header="外设" Binding="{Binding PeripheralName}" Width="72"/>
            <DataGridTextColumn Header="形式" Binding="{Binding Form}" Width="108"/>
            <DataGridTextColumn Header="解析" Binding="{Binding ParseStatus}" Width="72"/>
            <DataGridTextColumn Header="文件" Binding="{Binding FilePath}" Width="2*"
                                ElementStyle="{StaticResource DataGridEllipsisTextStyle}"/>
            <DataGridTextColumn Header="行" Binding="{Binding StartLine}" Width="48"/>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource AppCardBorderStyle}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
          <TextBlock Text="函数详情" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
          <TextBlock Margin="16,0,0,0" Foreground="{StaticResource BrushTextMuted}" Text="解析状态："/>
          <TextBlock Foreground="{StaticResource BrushAccent}" Text="{Binding ParseStatusText}"/>
        </StackPanel>
        <TabControl>
          <TabItem Header="基本信息">
            <StackPanel Margin="0,4,0,0">
              <TextBlock Text="签名" Foreground="{StaticResource BrushTextMuted}" FontSize="11"/>
              <TextBox Style="{StaticResource MonospaceReadOnlyTextBoxStyle}" MinHeight="48"
                       Text="{Binding DetailSignature, Mode=OneWay}"/>
              <TextBlock Text="返回类型" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,8,0,0"/>
              <TextBox Style="{StaticResource MonospaceReadOnlyTextBoxStyle}" MinHeight="36"
                       Text="{Binding DetailReturn, Mode=OneWay}"/>
              <TextBlock Text="参数" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,8,0,0"/>
              <TextBox Style="{StaticResource MonospaceReadOnlyTextBoxStyle}"
                       Text="{Binding DetailParameters, Mode=OneWay}"/>
            </StackPanel>
          </TabItem>
          <TabItem Header="源码">
            <TextBox Style="{StaticResource MonospaceReadOnlyTextBoxStyle}" Text="{Binding DetailSource, Mode=OneWay}"/>
          </TabItem>
          <TabItem Header="操作">
            <TextBox Style="{StaticResource MonospaceReadOnlyTextBoxStyle}" Text="{Binding DetailOperations, Mode=OneWay}"/>
          </TabItem>
          <TabItem Header="寄存器">
            <TextBox Style="{StaticResource MonospaceReadOnlyTextBoxStyle}" Text="{Binding DetailRegisters, Mode=OneWay}"/>
          </TabItem>
          <TabItem Header="宏引用">
            <TextBox Style="{StaticResource MonospaceReadOnlyTextBoxStyle}" Text="{Binding DetailMacros, Mode=OneWay}"/>
          </TabItem>
          <TabItem Header="调用">
            <TextBox Style="{StaticResource MonospaceReadOnlyTextBoxStyle}" Text="{Binding DetailCallGraph, Mode=OneWay}"/>
          </TabItem>
          <TabItem Header="诊断">
            <TextBox Style="{StaticResource MonospaceReadOnlyTextBoxStyle}" Text="{Binding DetailDiagnostics, Mode=OneWay}"/>
          </TabItem>
        </TabControl>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
