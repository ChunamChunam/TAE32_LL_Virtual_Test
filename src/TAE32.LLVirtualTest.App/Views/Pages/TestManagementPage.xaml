<UserControl x:Class="TAE32.LLVirtualTest.App.Views.Pages.TestManagementPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
  <Grid VerticalAlignment="Stretch">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,10">
      <StackPanel>
        <TextBlock Text="测试管理与报告" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
        <TextBlock Text="虚拟 MCU 软件测试管理 · 不等同于真实硬件测试" Foreground="{StaticResource BrushTextMuted}" Margin="0,4,0,0"/>
      </StackPanel>
      <Button HorizontalAlignment="Right" VerticalAlignment="Top"
              Style="{StaticResource GhostButtonStyle}"
              Content="刷新数据" Command="{Binding RefreshCommand}"/>
    </Grid>

    <TabControl Grid.Row="1" VerticalAlignment="Stretch"
                Style="{StaticResource AppTabControlStyle}"
                ItemContainerStyle="{StaticResource AppTabItemStyle}">
      <TabItem Header="测试计划">
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,8,0">
            <DockPanel>
              <Border DockPanel.Dock="Top" Padding="0,0,0,6" Margin="0,0,0,2"
                      BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBox Grid.Column="0" Text="{Binding PlanSearchText, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="名称 / 芯片 / 外设 / 状态 / 测试类型" Margin="0,0,8,0"/>
                  <ComboBox Grid.Column="1" Width="100" Margin="0,0,8,0"
                            ItemsSource="{Binding PlanStatusFilterOptions}"
                            SelectedItem="{Binding SelectedPlanStatusFilter}"
                            ToolTip="默认「全部状态」含已归档历史计划"/>
                  <Button Grid.Column="2" Style="{StaticResource GhostButtonStyle}" Content="查询"
                          Command="{Binding SearchPlansCommand}"/>
                </Grid>
              </Border>
              <Border DockPanel.Dock="Bottom" Style="{StaticResource GridPagerFooterStyle}" Margin="-10,-2,-10,-10"
                      Padding="8,6" CornerRadius="0,0,8,8">
                <DockPanel LastChildFill="True">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButtonStyle}" Content="‹" Padding="8,2"
                            Command="{Binding PlanPreviousPageCommand}" Margin="0,0,4,0"
                            IsEnabled="{Binding CanPlanPrev}"/>
                    <Button Style="{StaticResource GhostButtonStyle}" Content="›" Padding="8,2"
                            Command="{Binding PlanNextPageCommand}" IsEnabled="{Binding CanPlanNext}"/>
                  </StackPanel>
                  <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="每页" Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Width="56" ItemsSource="{Binding AvailableCasePageSizeOptions}"
                              SelectedItem="{Binding PlanPageSize}"/>
                  </StackPanel>
                  <TextBlock Text="{Binding PlanPageInfo}" Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                             VerticalAlignment="Center" Margin="10,0,8,0" TextTrimming="CharacterEllipsis"
                             ToolTip="{Binding PlanPageInfo}"/>
                </DockPanel>
              </Border>
              <DataGrid ItemsSource="{Binding Plans}" SelectedItem="{Binding SelectedPlan}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="2*"/>
                  <DataGridTextColumn Header="芯片" Binding="{Binding ChipModelName}" Width="*"/>
                  <DataGridTextColumn Header="外设" Binding="{Binding PeripheralFilter, TargetNullValue=(全部)}" Width="*"/>
                  <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="70"/>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Border>
          <Border Grid.Column="1" Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="10">
            <StackPanel>
              <TextBlock Text="编辑计划" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
              <TextBlock Text="名称" Foreground="{StaticResource BrushTextMuted}" Margin="0,8,0,0"/>
              <TextBox Text="{Binding PlanName, UpdateSourceTrigger=PropertyChanged}"/>
              <TextBlock Text="芯片型号" Foreground="{StaticResource BrushTextMuted}" Margin="0,8,0,0"/>
              <ComboBox ItemsSource="{Binding ChipFilterOptions}"
                        SelectedItem="{Binding PlanChip}"
                        IsEditable="False"
                        ToolTip="来自当前 SDK 项目解析入库的芯片（Chips），刷新数据后自动选中"/>
              <TextBlock Text="外设范围" Foreground="{StaticResource BrushTextMuted}" Margin="0,8,0,0"/>
              <ComboBox ItemsSource="{Binding PeripheralFilters}"
                        SelectedItem="{Binding PlanPeripheral}"
                        IsEditable="False"
                        ToolTip="选某一个外设：只生成并测试该外设；选「(全部)」：所有外设"/>
              <TextBlock Text="选「(全部)」= 所有外设；选具体名 = 仅该外设" Foreground="{StaticResource BrushTextMuted}"
                         FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
              <TextBlock Text="测试类型" Foreground="{StaticResource BrushTextMuted}" Margin="0,8,0,0"/>
              <TextBox Text="{Binding PlanTestType, UpdateSourceTrigger=PropertyChanged}"/>
              <WrapPanel Margin="0,12,0,0">
                <Button Content="保存计划" Command="{Binding SavePlanCommand}"/>
                <Button Content="复制" Command="{Binding DuplicatePlanCommand}"/>
                <Button Content="归档" Command="{Binding ArchivePlanCommand}"
                        ToolTip="归档后仍可在「全部状态 / 仅归档」中查看与恢复"/>
                <Button Content="恢复" Command="{Binding RestorePlanCommand}"
                        Style="{StaticResource GhostButtonStyle}"
                        ToolTip="将已归档计划恢复为 Active"/>
                <Button Content="生成并按计划执行" Command="{Binding RunPlanCommand}"
                        ToolTip="自动保存/保留当前计划（名称为空则按芯片·外设·时间生成），再按外设范围生成用例并批量执行"/>
              </WrapPanel>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="测试套件">
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1.2*"/>
          </Grid.ColumnDefinitions>
          <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,8,0">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock Text="套件" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                <TextBox Margin="0,6,0,0" Text="{Binding SuiteName, UpdateSourceTrigger=PropertyChanged}"/>
                <ComboBox Margin="0,6,0,0" ItemsSource="{Binding PeripheralFilters}"
                          SelectedItem="{Binding SuitePeripheral}" IsEditable="False"/>
                <WrapPanel Margin="0,8,0,0">
                  <Button Content="保存套件" Command="{Binding SaveSuiteCommand}"/>
                  <Button Content="执行套件" Command="{Binding RunSuiteCommand}"/>
                  <Button Content="按外设执行" Command="{Binding RunPeripheralCommand}"/>
                </WrapPanel>
                <DataGrid Margin="0,8,0,0" Height="140" ItemsSource="{Binding Suites}" SelectedItem="{Binding SelectedSuite}" AutoGenerateColumns="False" IsReadOnly="True">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="2*"/>
                    <DataGridTextColumn Header="外设" Binding="{Binding PeripheralName}" Width="*"/>
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
              <TextBlock DockPanel.Dock="Bottom" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap"
                         Text="已选用例数见右侧双击切换。套件仅引用已有真实 LL 测试用例。"/>
            </DockPanel>
          </Border>
          <Border Grid.Column="1" Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="10">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="真实用例列表（双击加入/移出套件）" FontWeight="SemiBold"
                         Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
              <Border DockPanel.Dock="Top" Padding="0,0,0,6" Margin="0,0,0,2"
                      BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBox Grid.Column="0" Text="{Binding AvailableCaseSearchText, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="名称 / 函数 / 外设（与左侧套件外设筛选叠加）" Margin="0,0,8,0"/>
                  <ComboBox Grid.Column="1" Width="100" Margin="0,0,8,0"
                            ItemsSource="{Binding CaseStatusFilterOptions}"
                            SelectedItem="{Binding SelectedAvailableCaseStatusFilter}"
                            ToolTip="按用例状态筛选"/>
                  <Button Grid.Column="2" Style="{StaticResource GhostButtonStyle}" Content="查询"
                          Command="{Binding SearchAvailableCasesCommand}"/>
                </Grid>
              </Border>
              <Border DockPanel.Dock="Bottom" Style="{StaticResource GridPagerFooterStyle}" Margin="-10,-2,-10,-10"
                      Padding="8,6" CornerRadius="0,0,8,8">
                <DockPanel LastChildFill="True">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButtonStyle}" Content="‹" Padding="8,2"
                            Command="{Binding AvailableCasePreviousPageCommand}" Margin="0,0,4,0"
                            IsEnabled="{Binding CanAvailableCasePrev}"/>
                    <Button Style="{StaticResource GhostButtonStyle}" Content="›" Padding="8,2"
                            Command="{Binding AvailableCaseNextPageCommand}" IsEnabled="{Binding CanAvailableCaseNext}"/>
                  </StackPanel>
                  <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="每页" Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Width="56" ItemsSource="{Binding AvailableCasePageSizeOptions}"
                              SelectedItem="{Binding AvailableCasePageSize}"/>
                  </StackPanel>
                  <TextBlock Text="{Binding AvailableCasePageInfo}" Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                             VerticalAlignment="Center" Margin="10,0,8,0" TextTrimming="CharacterEllipsis"
                             ToolTip="{Binding AvailableCasePageInfo}"/>
                </DockPanel>
              </Border>
              <ListBox x:Name="CaseList" ItemsSource="{Binding AvailableCases}" MouseDoubleClick="OnCaseDoubleClick"
                       Background="Transparent" BorderThickness="0" Padding="0"
                       ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"
                               Foreground="{StaticResource BrushTextPrimary}"/>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="执行历史">
        <Border Margin="0,8,0,0" Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="10">
          <DockPanel>
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
              <Button Content="非通过重跑" Command="{Binding RetryNonPassedCommand}"
                      ToolTip="重跑选中批次中所有非 Passed 的用例（含 Failed / Error / Timeout / Skipped / Cancelled；编译失败通常记为 Error）"/>
              <Button Content="仅断言失败" Command="{Binding RetryAssertionFailedCommand}"
                      Style="{StaticResource GhostButtonStyle}"
                      ToolTip="只重跑 Status=Failed（断言/寄存器不匹配等）"/>
              <Button Content="仅错误" Command="{Binding RetryErrorsCommand}"
                      Style="{StaticResource GhostButtonStyle}"
                      ToolTip="只重跑 Status=Error（含编译失败等）"/>
              <Button Content="取消执行" Command="{Binding CancelBatchCommand}"/>
              <Button Content="导出此批次报告" Command="{Binding ExportSelectedBatchReportCommand}" Margin="8,0,0,0" Padding="12,6"
                      ToolTip="导出「执行历史」当前选中批次的全部运行记录（与「总数」一致，可上千条）"/>
              <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource BrushAccent}" Text="{Binding ProgressText}"/>
            </WrapPanel>
            <ProgressBar DockPanel.Dock="Top" Height="6" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}"
                         Margin="0,0,0,8" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                         Background="#FF243040" Foreground="{StaticResource BrushAccent}" BorderThickness="0"/>
            <Border DockPanel.Dock="Top" Padding="0,0,0,6" Margin="0,0,0,2"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding HistorySearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="范围类型 / 范围名称" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="1" Width="100" Margin="0,0,8,0"
                          ItemsSource="{Binding BatchStatusFilterOptions}"
                          SelectedItem="{Binding SelectedHistoryStatusFilter}"
                          ToolTip="按批次状态筛选"/>
                <Button Grid.Column="2" Style="{StaticResource GhostButtonStyle}" Content="查询" Margin="0,0,8,0"
                        Command="{Binding SearchHistoryCommand}"/>
                <Button Grid.Column="3" Content="删除" Margin="0,0,8,0" Padding="10,4"
                        Command="{Binding DeleteHistorySelectedCommand}"
                        ToolTip="删除列表中当前选中的一条批次"/>
                <Button Grid.Column="4" Content="删除本页" Margin="0,0,8,0" Padding="10,4"
                        Command="{Binding DeleteHistoryPageCommand}"
                        ToolTip="删除当前页批次记录（不删 LlTestRun；Running 跳过）"/>
                <Button Grid.Column="5" Content="删除全部" Padding="10,4"
                        Command="{Binding DeleteHistoryAllCommand}"
                        ToolTip="删除当前筛选下全部批次（Running 跳过）"/>
              </Grid>
            </Border>
            <Border DockPanel.Dock="Bottom" Style="{StaticResource GridPagerFooterStyle}" Margin="-10,-2,-10,-10"
                    Padding="8,6" CornerRadius="0,0,8,8">
              <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Style="{StaticResource GhostButtonStyle}" Content="‹" Padding="8,2"
                          Command="{Binding HistoryPreviousPageCommand}" Margin="0,0,4,0"
                          IsEnabled="{Binding CanHistoryPrev}"/>
                  <Button Style="{StaticResource GhostButtonStyle}" Content="›" Padding="8,2"
                          Command="{Binding HistoryNextPageCommand}" IsEnabled="{Binding CanHistoryNext}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="每页" Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                  <ComboBox Width="56" ItemsSource="{Binding AvailableCasePageSizeOptions}"
                            SelectedItem="{Binding HistoryPageSize}"/>
                </StackPanel>
                <TextBlock Text="{Binding HistoryPageInfo}" Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                           VerticalAlignment="Center" Margin="10,0,8,0" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding HistoryPageInfo}"/>
              </DockPanel>
            </Border>
            <DataGrid ItemsSource="{Binding History}" SelectedItem="{Binding SelectedBatch}" AutoGenerateColumns="False" IsReadOnly="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80"/>
                <DataGridTextColumn Header="范围" Binding="{Binding ScopeKind}" Width="80"/>
                <DataGridTextColumn Header="总数" Binding="{Binding TotalCount}" Width="50"/>
                <DataGridTextColumn Header="通过" Binding="{Binding PassedCount}" Width="50"/>
                <DataGridTextColumn Header="失败" Binding="{Binding FailedCount}" Width="50"/>
                <DataGridTextColumn Header="错误" Binding="{Binding ErrorCount}" Width="50"/>
                <DataGridTextColumn Header="编译失败" Binding="{Binding CompileFailCount}" Width="70"/>
                <DataGridTextColumn Header="开始" Binding="{Binding StartedAtUtc, Converter={StaticResource BeijingTime}}" Width="150"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>
      </TabItem>

      <TabItem Header="统计覆盖率">
        <Grid Margin="0,8,0,0" VerticalAlignment="Stretch">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <Grid Grid.Column="0" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
              <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Style="{StaticResource DashboardSectionTitleStyle}" Text="测试统计" Margin="0"/>
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11"
                           Foreground="{StaticResource BrushTextMuted}" Text="{Binding StatsScopeHint}"/>
              </DockPanel>
              <UniformGrid Grid.Row="1" Columns="2" Rows="2">
                <Border Style="{StaticResource DashboardKpiCardStyle}" Margin="0,0,10,10">
                  <StackPanel Margin="16,14,14,14">
                    <TextBlock Style="{StaticResource DashboardKpiLabelStyle}" Text="用例总数"/>
                    <TextBlock Style="{StaticResource DashboardKpiValueStyle}" Text="{Binding Statistics.CaseTotal}"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource DashboardKpiCardStyle}" Margin="0,0,0,10">
                  <StackPanel Margin="16,14,14,14">
                    <TextBlock Style="{StaticResource DashboardKpiLabelStyle}" Text="已执行次数"/>
                    <TextBlock Style="{StaticResource DashboardKpiValueStyle}" Text="{Binding Statistics.ExecutedRuns}"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource DashboardKpiCardStyle}" Margin="0,0,10,10">
                  <StackPanel Margin="16,14,14,14">
                    <TextBlock Style="{StaticResource DashboardKpiLabelStyle}" Text="通过率"/>
                    <TextBlock Style="{StaticResource DashboardKpiValueStyle}" Foreground="{StaticResource BrushAccent}"
                               Text="{Binding Statistics.PassRate, StringFormat={}{0:F1}%}"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource DashboardKpiCardStyle}" Margin="0,0,0,10">
                  <StackPanel Margin="16,14,14,14">
                    <TextBlock Style="{StaticResource DashboardKpiLabelStyle}" Text="平均耗时 (ms)"/>
                    <TextBlock Style="{StaticResource DashboardKpiValueStyle}"
                               Text="{Binding Statistics.AverageDurationMs, StringFormat={}{0:F0}}"/>
                  </StackPanel>
                </Border>
              </UniformGrid>
              <Border Grid.Row="2" Style="{StaticResource AppCardBorderStyle}" Padding="14,12" VerticalAlignment="Stretch">
                <DockPanel LastChildFill="True">
                  <TextBlock DockPanel.Dock="Top" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Text="结果分布" Margin="0,0,0,10"/>
                  <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource BrushTextMuted}"
                             Text="{Binding Statistics.CompileFailRate, StringFormat=编译失败率 {0:F1}%}"/>
                  <WrapPanel VerticalAlignment="Top">
                    <Border Background="#FF1A2E28" CornerRadius="4" Padding="10,6" Margin="0,0,8,6">
                      <TextBlock FontSize="12" Foreground="{StaticResource BrushAccent}"
                                 Text="{Binding Statistics.Passed, StringFormat=通过 {0}}"/>
                    </Border>
                    <Border Background="#FF2A2228" CornerRadius="4" Padding="10,6" Margin="0,0,8,6">
                      <TextBlock FontSize="12" Foreground="#FFE8A0A0"
                                 Text="{Binding Statistics.Failed, StringFormat=失败 {0}}"/>
                    </Border>
                    <Border Background="#FF252A30" CornerRadius="4" Padding="10,6" Margin="0,0,8,6">
                      <TextBlock FontSize="12" Foreground="{StaticResource BrushTextMuted}"
                                 Text="{Binding Statistics.Error, StringFormat=错误 {0}}"/>
                    </Border>
                    <Border Background="#FF252A30" CornerRadius="4" Padding="10,6" Margin="0,0,8,6">
                      <TextBlock FontSize="12" Foreground="{StaticResource BrushTextMuted}"
                                 Text="{Binding Statistics.Skipped, StringFormat=跳过 {0}}"/>
                    </Border>
                    <Border Background="#FF252A30" CornerRadius="4" Padding="10,6" Margin="0,0,8,6">
                      <TextBlock FontSize="12" Foreground="{StaticResource BrushTextMuted}"
                                 Text="{Binding Statistics.Timeout, StringFormat=超时 {0}}"/>
                    </Border>
                  </WrapPanel>
                </DockPanel>
              </Border>
          </Grid>

          <Grid Grid.Column="2" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Style="{StaticResource DashboardSectionTitleStyle}" Text="覆盖率（真实口径，无数据为 N/A）"/>
              <Border Grid.Row="1" Style="{StaticResource AppCardBorderStyle}" Padding="14,12" Margin="0,0,0,10"
                      VerticalAlignment="Stretch">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Row="0" Grid.Column="0" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" Text="LL 函数" Margin="0,0,0,4"/>
                  <TextBlock Grid.Row="0" Grid.Column="1" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}"
                             Text="{Binding FunctionCoverageText}" Margin="0,0,0,8"/>
                  <TextBlock Grid.Row="1" Grid.ColumnSpan="2" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,12">
                    <TextBlock.Text>
                      <MultiBinding StringFormat="{}{0} / {1} 个 LL 函数">
                        <Binding Path="Coverage.FunctionsCoveredByCases"/>
                        <Binding Path="Coverage.FunctionsTotal"/>
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>

                  <TextBlock Grid.Row="2" Grid.Column="0" FontSize="12" Text="外设模块" Margin="0,0,0,4"/>
                  <TextBlock Grid.Row="2" Grid.Column="1" FontSize="20" FontWeight="SemiBold" Text="{Binding PeripheralCoverageText}" Margin="0,0,0,8"/>
                  <TextBlock Grid.Row="3" Grid.ColumnSpan="2" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,12">
                    <TextBlock.Text>
                      <MultiBinding StringFormat="{}{0} / {1} 个外设">
                        <Binding Path="Coverage.PeripheralsCoveredByCases"/>
                        <Binding Path="Coverage.PeripheralsTotal"/>
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>

                  <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,8,0,0">
                    <Grid Margin="0,0,0,10">
                      <TextBlock FontSize="12" Text="寄存器访问" VerticalAlignment="Center"/>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}"
                                   Text="{Binding RegisterCoverageText}" Margin="0,0,8,0"/>
                        <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource BrushTextMuted}">
                          <TextBlock.Text>
                            <MultiBinding StringFormat="({0}/{1})">
                              <Binding Path="Coverage.RegistersTouchedInRuns"/>
                              <Binding Path="Coverage.RegistersReferencedInParse"/>
                            </MultiBinding>
                          </TextBlock.Text>
                        </TextBlock>
                      </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                      <TextBlock FontSize="12" Text="位域断言" VerticalAlignment="Center"/>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding BitFieldCoverageText}" Margin="0,0,8,0"/>
                        <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource BrushTextMuted}">
                          <TextBlock.Text>
                            <MultiBinding StringFormat="({0}/{1})">
                              <Binding Path="Coverage.BitFieldsAsserted"/>
                              <Binding Path="Coverage.BitFieldsTotal"/>
                            </MultiBinding>
                          </TextBlock.Text>
                        </TextBlock>
                      </StackPanel>
                    </Grid>
                    <Grid>
                      <TextBlock FontSize="12" Text="用例至少执行一次" VerticalAlignment="Center"/>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding CaseCoverageText}" Margin="0,0,8,0"/>
                        <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource BrushTextMuted}">
                          <TextBlock.Text>
                            <MultiBinding StringFormat="({0}/{1})">
                              <Binding Path="Coverage.CasesExecutedAtLeastOnce"/>
                              <Binding Path="Coverage.CasesTotal"/>
                            </MultiBinding>
                          </TextBlock.Text>
                        </TextBlock>
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Grid>
              </Border>
              <Border Grid.Row="2" Background="#FF1A222C" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                      CornerRadius="6" Padding="12,10" VerticalAlignment="Bottom">
                <TextBlock Text="{Binding CoverageNotes}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
              </Border>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="失败分析">
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,8,0">
            <DockPanel>
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="打开源码" Command="{Binding OpenSourceCommand}"
                        CommandParameter="{Binding SelectedFailureRow.Item}" Margin="0" Padding="12,6"
                        HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <TextBlock Text="失败 / 错误 / 超时" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>
              </DockPanel>
              <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding FailureSearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="用例名 / 函数名 / 失败原因" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="1" Width="100" Margin="0,0,8,0"
                          ItemsSource="{Binding FailureStatusFilterOptions}"
                          SelectedItem="{Binding SelectedFailureStatusFilter}"
                          ToolTip="按失败状态筛选"/>
                <Button Grid.Column="2" Style="{StaticResource GhostButtonStyle}" Content="查询" Margin="0,0,8,0"
                        Command="{Binding SearchFailuresCommand}"/>
                <CheckBox Grid.Column="3" Content="页全选" IsChecked="{Binding IsAllFailuresOnPageSelected}"
                          VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button Grid.Column="4" Content="删除" Margin="0,0,8,0" Padding="10,4"
                        Command="{Binding DeleteSelectedFailuresCommand}"
                        ToolTip="删除勾选的运行记录"/>
                <Button Grid.Column="5" Content="删除本页" Margin="0,0,8,0" Padding="10,4"
                        Command="{Binding DeleteFailuresPageCommand}"/>
                <Button Grid.Column="6" Content="删除全部" Padding="10,4"
                        Command="{Binding DeleteFailuresAllCommand}"/>
              </Grid>
              <Border DockPanel.Dock="Bottom" Style="{StaticResource GridPagerFooterStyle}" Margin="-10,-2,-10,-10"
                      Padding="8,6" CornerRadius="0,0,8,8">
                <DockPanel LastChildFill="True">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButtonStyle}" Content="‹" Padding="8,2"
                            Command="{Binding FailurePreviousPageCommand}" Margin="0,0,4,0"
                            IsEnabled="{Binding CanFailurePrev}"/>
                    <Button Style="{StaticResource GhostButtonStyle}" Content="›" Padding="8,2"
                            Command="{Binding FailureNextPageCommand}" IsEnabled="{Binding CanFailureNext}"/>
                  </StackPanel>
                  <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="每页" Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Width="56" ItemsSource="{Binding AvailableCasePageSizeOptions}"
                              SelectedItem="{Binding FailurePageSize}"/>
                  </StackPanel>
                  <TextBlock Text="{Binding FailurePageInfo}" Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                             VerticalAlignment="Center" Margin="10,0,8,0" TextTrimming="CharacterEllipsis"
                             ToolTip="{Binding FailurePageInfo}"/>
                </DockPanel>
              </Border>
              <DataGrid ItemsSource="{Binding FailureRows}" SelectedItem="{Binding SelectedFailureRow}"
                        AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="选" Width="36">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Center"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="用例" Binding="{Binding CaseName}" Width="*" IsReadOnly="True"
                                      ElementStyle="{StaticResource DataGridEllipsisTextStyle}"/>
                  <DataGridTextColumn Header="函数" Binding="{Binding FunctionName}" Width="*" IsReadOnly="True"
                                      ElementStyle="{StaticResource DataGridEllipsisTextStyle}"/>
                  <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="70" IsReadOnly="True"/>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Border>
          <Border Grid.Column="1" Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="10">
            <TextBox Text="{Binding FailureDetail, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
                     Background="{StaticResource BrushBgInput}" Foreground="{StaticResource BrushTextPrimary}" BorderThickness="0"/>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="报告管理">
        <Border Margin="0,8,0,0" Style="{StaticResource AppCardBorderStyle}" Padding="10">
          <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
              <TextBlock Text="导出报告（真实运行数据）" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
              <TextBlock Text="{Binding ExportScopeHint}" Foreground="{StaticResource BrushTextMuted}" Margin="0,4,0,8"
                         TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal">
                <ComboBox Width="100" SelectedValue="{Binding SelectedReportFormat}" SelectedValuePath="Content">
                  <ComboBoxItem Content="Html" IsSelected="True"/>
                  <ComboBoxItem Content="Pdf"/>
                  <ComboBoxItem Content="Excel"/>
                  <ComboBoxItem Content="Csv"/>
                </ComboBox>
                <ComboBox Width="260" Margin="8,0,0,0"
                          ItemsSource="{Binding ExportRunScopeOptions}"
                          SelectedItem="{Binding SelectedExportRunScope}"/>
                <Button Content="导出报告" Command="{Binding ExportReportCommand}" Margin="8,0,0,0" Padding="12,6"/>
                <TextBlock Text="虚拟 MCU，不等同真实硬件。" VerticalAlignment="Center"
                           Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="16,0,0,0"/>
              </StackPanel>
            </StackPanel>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="280"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1.15*" MinWidth="320"/>
              </Grid.ColumnDefinitions>

              <!-- 左：选择要导出的批次（分组） -->
              <Border Grid.Column="0" Background="{StaticResource BrushBgCard}"
                      BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="8">
                <DockPanel LastChildFill="True">
                  <TextBlock DockPanel.Dock="Top" Text="导出批次（按类型排序，同类型相邻）" FontWeight="SemiBold"
                             Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,6"/>
                  <Border DockPanel.Dock="Top" Padding="0,0,0,6" Margin="0,0,0,2"
                          BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBox Grid.Column="0" Text="{Binding ExportBatchSearchText, UpdateSourceTrigger=PropertyChanged}"
                               ToolTip="范围类型 / 范围值" Margin="0,0,6,0"/>
                      <ComboBox Grid.Column="1" Width="100" Margin="0,0,6,0"
                                ItemsSource="{Binding BatchStatusFilterOptions}"
                                SelectedItem="{Binding SelectedExportBatchStatusFilter}"
                                ToolTip="按批次状态筛选"/>
                      <Button Grid.Column="2" Style="{StaticResource GhostButtonStyle}" Content="查询"
                              Command="{Binding SearchExportBatchesCommand}"/>
                    </Grid>
                  </Border>
                  <Border DockPanel.Dock="Bottom" Padding="0,6,0,0"
                          BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0">
                    <DockPanel LastChildFill="True">
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButtonStyle}" Content="‹" Padding="8,2"
                                Command="{Binding ExportBatchPreviousPageCommand}" Margin="0,0,4,0"
                                IsEnabled="{Binding CanExportBatchPrev}"/>
                        <Button Style="{StaticResource GhostButtonStyle}" Content="›" Padding="8,2"
                                Command="{Binding ExportBatchNextPageCommand}" IsEnabled="{Binding CanExportBatchNext}"/>
                      </StackPanel>
                      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="每页" Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="56" ItemsSource="{Binding AvailableCasePageSizeOptions}"
                                  SelectedItem="{Binding ExportBatchPageSize}"/>
                      </StackPanel>
                      <TextBlock Text="{Binding ExportBatchPageInfo}" Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                                 VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"
                                 ToolTip="{Binding ExportBatchPageInfo}"/>
                    </DockPanel>
                  </Border>
                  <DataGrid ItemsSource="{Binding ExportBatchTableView}" SelectedItem="{Binding SelectedBatch}"
                            AutoGenerateColumns="False" IsReadOnly="True"
                            HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single"
                            CanUserResizeColumns="False" CanUserReorderColumns="False" RowHeaderWidth="0"
                            HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="类型" Binding="{Binding ScopeKind}" Width="68"/>
                      <DataGridTextColumn Header="范围值" Binding="{Binding ScopeValue}" Width="*"
                                          MinWidth="72" ElementStyle="{StaticResource DataGridEllipsisTextStyle}"/>
                      <DataGridTextColumn Header="开始" Width="150"
                                          Binding="{Binding StartedAtUtc, Converter={StaticResource BeijingTime}}"/>
                      <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="76"/>
                      <DataGridTextColumn Header="总数" Binding="{Binding TotalCount}" Width="44"/>
                      <DataGridTextColumn Header="过" Binding="{Binding PassedCount}" Width="36"/>
                      <DataGridTextColumn Header="败" Binding="{Binding FailedCount}" Width="36"/>
                    </DataGrid.Columns>
                  </DataGrid>
                </DockPanel>
              </Border>

              <!-- 右：已生成报告 -->
              <Border Grid.Column="2" Background="{StaticResource BrushBgCard}"
                      BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="8">
                <DockPanel LastChildFill="True">
                  <TextBlock DockPanel.Dock="Top" Text="已生成报告" FontWeight="SemiBold"
                             Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,6"/>
                  <Border DockPanel.Dock="Top" Padding="0,0,0,6" Margin="0,0,0,2"
                          BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBox Grid.Column="0" Text="{Binding ArtifactSearchText, UpdateSourceTrigger=PropertyChanged}"
                               ToolTip="格式 / 标题 / 路径" Margin="0,0,6,0"/>
                      <Button Grid.Column="1" Style="{StaticResource GhostButtonStyle}" Content="查询" Margin="0,0,6,0"
                              Command="{Binding SearchArtifactsCommand}"/>
                      <Button Grid.Column="2" Style="{StaticResource GhostButtonStyle}" Content="打开" Margin="0,0,6,0"
                              Command="{Binding OpenArtifactCommand}" ToolTip="打开选中报告"/>
                      <Button Grid.Column="3" Content="删除" Margin="0,0,6,0" Padding="8,4"
                              Command="{Binding DeleteArtifactSelectedCommand}"/>
                      <Button Grid.Column="4" Content="删本页" Margin="0,0,6,0" Padding="8,4"
                              Command="{Binding DeleteArtifactsPageCommand}"/>
                      <Button Grid.Column="5" Content="删全部" Padding="8,4"
                              Command="{Binding DeleteArtifactsAllCommand}"/>
                    </Grid>
                  </Border>
                  <Border DockPanel.Dock="Bottom" Padding="0,6,0,0"
                          BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0">
                    <DockPanel LastChildFill="True">
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButtonStyle}" Content="‹" Padding="8,2"
                                Command="{Binding ArtifactPreviousPageCommand}" Margin="0,0,4,0"
                                IsEnabled="{Binding CanArtifactPrev}"/>
                        <Button Style="{StaticResource GhostButtonStyle}" Content="›" Padding="8,2"
                                Command="{Binding ArtifactNextPageCommand}" IsEnabled="{Binding CanArtifactNext}"/>
                      </StackPanel>
                      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="每页" Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="56" ItemsSource="{Binding AvailableCasePageSizeOptions}"
                                  SelectedItem="{Binding ArtifactPageSize}"/>
                      </StackPanel>
                      <TextBlock Text="{Binding ArtifactPageInfo}" Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                                 VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"
                                 ToolTip="{Binding ArtifactPageInfo}"/>
                    </DockPanel>
                  </Border>
                  <DataGrid ItemsSource="{Binding Artifacts}" SelectedItem="{Binding SelectedArtifact}"
                            AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="OnArtifactDoubleClick">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="格式" Binding="{Binding Format}" Width="56"/>
                      <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="*"
                                          ElementStyle="{StaticResource DataGridEllipsisTextStyle}"/>
                      <DataGridTextColumn Header="路径" Binding="{Binding FilePath}" Width="*"
                                          ElementStyle="{StaticResource DataGridEllipsisTextStyle}"/>
                      <DataGridTextColumn Header="时间" Binding="{Binding CreatedAtUtc, Converter={StaticResource BeijingTime}}" Width="150"/>
                    </DataGrid.Columns>
                  </DataGrid>
                </DockPanel>
              </Border>
            </Grid>
          </DockPanel>
        </Border>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" Margin="0,10,0,0" Padding="10,8" Background="{StaticResource BrushBgPanel}"
            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6">
      <TextBlock Foreground="{StaticResource BrushTextMuted}" Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="12"/>
    </Border>

    <!-- Busy overlay -->
    <Border Grid.RowSpan="3" Background="#CC0F1419"
            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
        <ProgressBar IsIndeterminate="True" Height="4" Width="280" Margin="0,0,0,16"
                     Foreground="{StaticResource BrushAccent}" Background="{StaticResource BrushBorder}"/>
        <TextBlock Text="{Binding BusyOverlayText}" Foreground="{StaticResource BrushTextPrimary}"
                   FontSize="15" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBlock Text="请勿关闭窗口；大批量执行可能耗时较长" Foreground="{StaticResource BrushTextMuted}"
                   FontSize="12" TextAlignment="Center"/>
        <Button Content="取消执行" Command="{Binding CancelBatchCommand}" Margin="0,20,0,0"
                HorizontalAlignment="Center"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
