<UserControl x:Class="TAE32.LLVirtualTest.App.Views.Pages.TestManagementPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel Margin="0,0,0,10">
      <StackPanel>
        <TextBlock Text="测试管理与报告" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
        <TextBlock Text="虚拟 MCU 软件测试管理 · 不等同于真实硬件测试" Foreground="{StaticResource BrushTextMuted}" Margin="0,4,0,0"/>
      </StackPanel>
      <Button DockPanel.Dock="Right" Content="刷新" Command="{Binding RefreshCommand}" VerticalAlignment="Center"/>
    </DockPanel>

    <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
      <TabItem Header="测试计划">
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,8,0">
            <DataGrid ItemsSource="{Binding Plans}" SelectedItem="{Binding SelectedPlan}" AutoGenerateColumns="False" IsReadOnly="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="芯片" Binding="{Binding ChipModelName}" Width="*"/>
                <DataGridTextColumn Header="外设" Binding="{Binding PeripheralFilter}" Width="*"/>
                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="70"/>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
          <Border Grid.Column="1" Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="10">
            <StackPanel>
              <TextBlock Text="编辑计划" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
              <TextBlock Text="名称" Foreground="{StaticResource BrushTextMuted}" Margin="0,8,0,0"/>
              <TextBox Text="{Binding PlanName, UpdateSourceTrigger=PropertyChanged}"/>
              <TextBlock Text="芯片型号" Foreground="{StaticResource BrushTextMuted}" Margin="0,8,0,0"/>
              <TextBox Text="{Binding PlanChip, UpdateSourceTrigger=PropertyChanged}"/>
              <TextBlock Text="外设过滤" Foreground="{StaticResource BrushTextMuted}" Margin="0,8,0,0"/>
              <ComboBox ItemsSource="{Binding PeripheralFilters}"
                        SelectedItem="{Binding PlanPeripheral}"
                        IsEditable="False"/>
              <TextBlock Text="测试类型" Foreground="{StaticResource BrushTextMuted}" Margin="0,8,0,0"/>
              <TextBox Text="{Binding PlanTestType, UpdateSourceTrigger=PropertyChanged}"/>
              <WrapPanel Margin="0,12,0,0">
                <Button Content="保存计划" Command="{Binding SavePlanCommand}"/>
                <Button Content="复制" Command="{Binding DuplicatePlanCommand}"/>
                <Button Content="归档" Command="{Binding ArchivePlanCommand}"/>
                <Button Content="按计划执行" Command="{Binding RunPlanCommand}"/>
              </WrapPanel>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="测试套件">
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1.2*"/>
          </Grid.ColumnDefinitions>
          <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,8,0">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock Text="套件" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                <TextBox Margin="0,6,0,0" Text="{Binding SuiteName, UpdateSourceTrigger=PropertyChanged}"/>
                <ComboBox Margin="0,6,0,0" ItemsSource="{Binding PeripheralFilters}"
                          SelectedItem="{Binding SuitePeripheral}" IsEditable="False"/>
                <WrapPanel Margin="0,8,0,0">
                  <Button Content="保存套件" Command="{Binding SaveSuiteCommand}"/>
                  <Button Content="执行套件" Command="{Binding RunSuiteCommand}"/>
                  <Button Content="按外设执行" Command="{Binding RunPeripheralCommand}"/>
                </WrapPanel>
                <DataGrid Margin="0,8,0,0" Height="140" ItemsSource="{Binding Suites}" SelectedItem="{Binding SelectedSuite}" AutoGenerateColumns="False" IsReadOnly="True">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="2*"/>
                    <DataGridTextColumn Header="外设" Binding="{Binding PeripheralName}" Width="*"/>
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
              <TextBlock DockPanel.Dock="Bottom" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap"
                         Text="已选用例数见右侧双击切换。套件仅引用已有真实 LL 测试用例。"/>
            </DockPanel>
          </Border>
          <Border Grid.Column="1" Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="10">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="真实用例列表（双击加入/移出套件）" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,8"/>
              <ListBox x:Name="CaseList" ItemsSource="{Binding AvailableCases}" MouseDoubleClick="OnCaseDoubleClick" DisplayMemberPath="Name"/>
            </DockPanel>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="执行历史">
        <Border Margin="0,8,0,0" Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="10">
          <DockPanel>
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
              <Button Content="失败重跑" Command="{Binding RetryFailedCommand}"/>
              <Button Content="取消执行" Command="{Binding CancelBatchCommand}"/>
              <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource BrushAccent}" Text="{Binding ProgressText}"/>
            </WrapPanel>
            <ProgressBar DockPanel.Dock="Top" Height="8" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Margin="0,0,0,8"/>
            <DataGrid ItemsSource="{Binding History}" SelectedItem="{Binding SelectedBatch}" AutoGenerateColumns="False" IsReadOnly="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80"/>
                <DataGridTextColumn Header="范围" Binding="{Binding ScopeKind}" Width="80"/>
                <DataGridTextColumn Header="总数" Binding="{Binding TotalCount}" Width="50"/>
                <DataGridTextColumn Header="通过" Binding="{Binding PassedCount}" Width="50"/>
                <DataGridTextColumn Header="失败" Binding="{Binding FailedCount}" Width="50"/>
                <DataGridTextColumn Header="错误" Binding="{Binding ErrorCount}" Width="50"/>
                <DataGridTextColumn Header="编译失败" Binding="{Binding CompileFailCount}" Width="70"/>
                <DataGridTextColumn Header="开始" Binding="{Binding StartedAtUtc}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>
      </TabItem>

      <TabItem Header="统计覆盖率">
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="测试统计" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,8"/>
              <TextBox Text="{Binding StatsText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" Background="{StaticResource BrushBgInput}" Foreground="{StaticResource BrushTextPrimary}"/>
            </DockPanel>
          </Border>
          <Border Grid.Column="1" Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="覆盖率（真实口径，无数据则为 N/A）" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,8"/>
              <TextBox Text="{Binding CoverageText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" Background="{StaticResource BrushBgInput}" Foreground="{StaticResource BrushTextPrimary}"/>
            </DockPanel>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="失败分析">
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,8,0">
            <DockPanel>
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock Text="失败 / 错误 / 超时" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Content="打开源码" Command="{Binding OpenSourceCommand}" CommandParameter="{Binding SelectedFailure}"/>
              </DockPanel>
              <DataGrid ItemsSource="{Binding Failures}" SelectedItem="{Binding SelectedFailure}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="用例" Binding="{Binding CaseName}" Width="*"/>
                  <DataGridTextColumn Header="函数" Binding="{Binding FunctionName}" Width="*"/>
                  <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="70"/>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Border>
          <Border Grid.Column="1" Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="10">
            <TextBox Text="{Binding FailureDetail, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
                     Background="{StaticResource BrushBgInput}" Foreground="{StaticResource BrushTextPrimary}" BorderThickness="0"/>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="报告管理">
        <Border Margin="0,8,0,0" Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
              <TextBlock Text="导出报告（真实运行数据）" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
              <TextBlock Text="报告将声明：基于虚拟 MCU，不等同真实硬件测试。PDF 为可打印 HTML。" Foreground="{StaticResource BrushTextMuted}" Margin="0,4,0,8"/>
              <WrapPanel>
                <ComboBox Width="120" SelectedValue="{Binding SelectedReportFormat}" SelectedValuePath="Content">
                  <ComboBoxItem Content="Html" IsSelected="True"/>
                  <ComboBoxItem Content="Pdf"/>
                  <ComboBoxItem Content="Excel"/>
                  <ComboBoxItem Content="Csv"/>
                </ComboBox>
                <Button Content="导出报告" Command="{Binding ExportReportCommand}" Margin="8,0,0,0"/>
              </WrapPanel>
            </StackPanel>
            <DataGrid ItemsSource="{Binding Artifacts}" AutoGenerateColumns="False" IsReadOnly="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="格式" Binding="{Binding Format}" Width="70"/>
                <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="路径" Binding="{Binding FilePath}" Width="2*"/>
                <DataGridTextColumn Header="时间" Binding="{Binding CreatedAtUtc}" Width="140"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>
      </TabItem>
    </TabControl>

    <TextBlock Grid.Row="2" Margin="0,8,0,0" Foreground="{StaticResource BrushTextMuted}" Text="{Binding StatusText}" TextWrapping="Wrap"/>
  </Grid>
</UserControl>
