<UserControl x:Class="TAE32.LLVirtualTest.App.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="20">
      <StackPanel>
        <TextBlock Text="系统设置" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,12"/>
        <TextBlock Text="工作区" Foreground="{StaticResource BrushTextMuted}"/>
        <TextBlock Text="{Binding WorkspaceRoot}" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <TextBlock Text="数据库" Foreground="{StaticResource BrushTextMuted}"/>
        <TextBlock Text="{Binding DatabasePath}" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <TextBlock Text="日志目录" Foreground="{StaticResource BrushTextMuted}"/>
        <TextBlock Text="{Binding LogDirectory}" TextWrapping="Wrap" Margin="0,0,0,16"/>

        <TextBlock Text="运维" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,8"/>
        <WrapPanel Margin="0,0,0,12">
          <Button Content="备份数据库" Command="{Binding BackupDatabaseCommand}" Margin="0,0,8,8" Padding="12,6"/>
          <Button Content="恢复数据库…" Command="{Binding RestoreDatabaseCommand}" Margin="0,0,8,8" Padding="12,6"/>
          <Button Content="清理旧日志(14天)" Command="{Binding TrimLogsCommand}" Margin="0,0,8,8" Padding="12,6"/>
          <Button Content="打开日志目录" Command="{Binding OpenLogFolderCommand}" Margin="0,0,8,8" Padding="12,6"/>
          <Button Content="刷新诊断" Command="{Binding RefreshDiagnosticsCommand}" Margin="0,0,8,8" Padding="12,6"/>
        </WrapPanel>

        <TextBlock Text="诊断摘要" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,4"/>
        <TextBox Text="{Binding Diagnostics}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                 MinHeight="120" MaxHeight="240" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>
        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource BrushAccent}" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBlock Text="{Binding Note}" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
