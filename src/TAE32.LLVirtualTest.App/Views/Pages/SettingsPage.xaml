<UserControl x:Class="TAE32.LLVirtualTest.App.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
  <Grid Margin="0,0,8,0" VerticalAlignment="Stretch">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource AppCardBorderStyle}" Margin="0,0,0,12">
      <StackPanel>
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource GhostButtonStyle}" Content="刷新诊断"
                  Command="{Binding RefreshDiagnosticsCommand}"/>
          <TextBlock Text="系统设置" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
        </DockPanel>
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource BrushTextMuted}"
                   Text="本地路径、数据库备份与日志维护。不修改 SDKContent 原始源码。"/>
        <TextBlock Margin="0,8,0,0" Foreground="{StaticResource BrushAccent}" TextWrapping="Wrap"
                   Text="{Binding StatusText}"/>
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" VerticalAlignment="Stretch">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" MinHeight="220"/>
        <RowDefinition Height="12"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource AppCardBorderStyle}" VerticalAlignment="Stretch">
        <StackPanel VerticalAlignment="Top">
          <TextBlock Text="路径" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,12"/>
          <TextBlock Text="工作区根目录" FontSize="12" Foreground="{StaticResource BrushTextMuted}"/>
          <TextBox Margin="0,6,0,10" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                   Text="{Binding WorkspaceRoot, Mode=OneWay}" TextWrapping="Wrap"/>
          <TextBlock Text="SQLite 数据库（程序目录\data）" FontSize="12" Foreground="{StaticResource BrushTextMuted}"/>
          <TextBox Margin="0,6,0,10" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                   Text="{Binding DatabasePath, Mode=OneWay}" TextWrapping="Wrap"/>
          <TextBlock Text="应用日志目录" FontSize="12" Foreground="{StaticResource BrushTextMuted}"/>
          <TextBox Margin="0,6,0,0" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                   Text="{Binding LogDirectory, Mode=OneWay}" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource AppCardBorderStyle}" VerticalAlignment="Stretch">
        <StackPanel VerticalAlignment="Top">
          <TextBlock Text="运维" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,12"/>
          <TextBlock FontSize="12" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" Margin="0,0,0,12"
                     Text="备份在 data 目录生成带时间戳的 .db 副本；恢复前会自动另存 pre_restore 副本。"/>
          <Button HorizontalAlignment="Left" Content="备份数据库" Command="{Binding BackupDatabaseCommand}" Margin="0,0,0,8"/>
          <Button HorizontalAlignment="Left" Content="从备份恢复…" Command="{Binding RestoreDatabaseCommand}"
                  Margin="0,0,0,16" Background="#FF6B3A3A"/>
          <TextBlock Text="界面缩放" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,8"/>
          <TextBlock FontSize="11" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" Margin="0,0,0,6"
                     Text="适用于高分辨率屏或最大化窗口；与系统显示缩放叠加生效。设置保存在 data/ui-scale.json。"/>
          <ComboBox HorizontalAlignment="Left" MinWidth="120" Margin="0,0,0,16"
                    ItemsSource="{Binding UiScalePresets}" SelectedItem="{Binding UiScale}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding StringFormat={}{0:P0}}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="日志" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,8"/>
          <WrapPanel>
            <Button Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Left"
                    Content="清理 14 天前日志" Command="{Binding TrimLogsCommand}" Margin="0,0,8,8"/>
            <Button Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Left"
                    Content="打开日志目录" Command="{Binding OpenLogFolderCommand}" Margin="0,0,8,8"/>
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource AppCardBorderStyle}" VerticalAlignment="Stretch">
        <DockPanel LastChildFill="True">
          <TextBlock DockPanel.Dock="Top" Text="环境诊断" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"
                     Margin="0,0,0,10"/>
          <TextBox Style="{StaticResource MonospaceReadOnlyTextBoxStyle}"
                   VerticalAlignment="Stretch" VerticalScrollBarVisibility="Auto"
                   Text="{Binding Diagnostics, Mode=OneWay}"/>
        </DockPanel>
      </Border>
    </Grid>

    <Border Grid.Row="2" Margin="0,12,0,0" Background="{StaticResource BrushBgInput}" CornerRadius="6"
            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Padding="12,10">
      <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource BrushTextMuted}" Text="{Binding Note}"/>
    </Border>
  </Grid>
</UserControl>
