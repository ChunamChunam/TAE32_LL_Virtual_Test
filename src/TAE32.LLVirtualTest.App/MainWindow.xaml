<Window x:Class="TAE32.LLVirtualTest.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="clr-namespace:TAE32.LLVirtualTest.App.ViewModels.Pages"
        xmlns:views="clr-namespace:TAE32.LLVirtualTest.App.Views.Pages"
        Title="TAE32 LL Virtual Test"
        Width="1280" Height="800"
        MinWidth="1024" MinHeight="640"
        Background="{StaticResource BrushBgDeep}"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <DataTemplate DataType="{x:Type pages:DashboardViewModel}">
      <views:DashboardPage/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:SdkManagementViewModel}">
      <views:SdkManagementPage/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:ChipManagementViewModel}">
      <views:ChipManagementPage/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:PeripheralManagementViewModel}">
      <views:PeripheralManagementPage/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:LlFunctionLibraryViewModel}">
      <views:LlFunctionLibraryPage/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:RegisterManagementViewModel}">
      <views:RegisterManagementPage/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:VirtualMcuViewModel}">
      <views:VirtualMcuPage/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:AutomationTestViewModel}">
      <views:AutomationTestPage/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:TestManagementViewModel}">
      <views:TestManagementPage/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:PlaceholderPageViewModel}">
      <views:PlaceholderPage/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:SettingsViewModel}">
      <views:SettingsPage/>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Left nav -->
    <Border Grid.Column="0" Background="{StaticResource BrushBgPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="16,20,16,12">
          <TextBlock Text="TAE32" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushAccent}"/>
          <TextBlock Text="LL Virtual Test" FontSize="13" Foreground="{StaticResource BrushTextMuted}"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Button Style="{StaticResource NavButtonStyle}" Content="工作台" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/>
            <Button Style="{StaticResource NavButtonStyle}" Content="SDK 管理" Command="{Binding NavigateCommand}" CommandParameter="SdkManagement"/>
            <Button Style="{StaticResource NavButtonStyle}" Content="芯片管理" Command="{Binding NavigateCommand}" CommandParameter="ChipManagement"/>
            <Button Style="{StaticResource NavButtonStyle}" Content="外设管理" Command="{Binding NavigateCommand}" CommandParameter="PeripheralManagement"/>
            <Button Style="{StaticResource NavButtonStyle}" Content="LL 函数库" Command="{Binding NavigateCommand}" CommandParameter="LlFunctionLibrary"/>
            <Button Style="{StaticResource NavButtonStyle}" Content="函数调用关系" Command="{Binding NavigateCommand}" CommandParameter="FunctionCallGraph"/>
            <Button Style="{StaticResource NavButtonStyle}" Content="寄存器管理" Command="{Binding NavigateCommand}" CommandParameter="RegisterManagement"/>
            <Button Style="{StaticResource NavButtonStyle}" Content="虚拟 MCU" Command="{Binding NavigateCommand}" CommandParameter="VirtualMcu"/>
            <Button Style="{StaticResource NavButtonStyle}" Content="自动化测试" Command="{Binding NavigateCommand}" CommandParameter="AutomationTest"/>
            <Button Style="{StaticResource NavButtonStyle}" Content="测试管理" Command="{Binding NavigateCommand}" CommandParameter="TestReport"/>
            <Button Style="{StaticResource NavButtonStyle}" Content="系统设置" Command="{Binding NavigateCommand}" CommandParameter="Settings"/>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Main area -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="52"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="28"/>
      </Grid.RowDefinitions>

      <!-- Top toolbar -->
      <Border Grid.Row="0" Background="{StaticResource BrushBgPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="16,0">
        <DockPanel>
          <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
          <TextBlock DockPanel.Dock="Right" Text="Phase-7 Test Management" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>

      <!-- Workspace -->
      <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Margin="16"/>

      <!-- Status bar -->
      <Border Grid.Row="2" Background="#FF0C1015" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="12,0">
        <DockPanel>
          <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
          <TextBlock DockPanel.Dock="Right" Text=".NET 8 / WPF / MVVM / SQLite" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
