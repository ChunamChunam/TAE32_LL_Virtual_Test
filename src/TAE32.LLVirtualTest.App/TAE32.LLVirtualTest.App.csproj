<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TAE32.LLVirtualTest.Core\TAE32.LLVirtualTest.Core.csproj" />
    <ProjectReference Include="..\TAE32.LLVirtualTest.Infrastructure\TAE32.LLVirtualTest.Infrastructure.csproj" />
    <ProjectReference Include="..\TAE32.LLVirtualTest.SDK\TAE32.LLVirtualTest.SDK.csproj" />
  </ItemGroup>

  <!-- NativeRunner is a sibling exe (not ProjectReference — NETSDK1150 if App is self-contained). -->
  <PropertyGroup>
    <_NativeRunnerProj>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\TAE32.LLVirtualTest.NativeRunner\TAE32.LLVirtualTest.NativeRunner.csproj'))</_NativeRunnerProj>
  </PropertyGroup>

  <Target Name="BuildNativeRunner" BeforeTargets="CopyNativeRunner">
    <PropertyGroup>
      <_NrSelfContained Condition="'$(SelfContained)' == 'true'">true</_NrSelfContained>
      <_NrSelfContained Condition="'$(_NrSelfContained)' == ''">false</_NrSelfContained>
      <_NrRid>$(RuntimeIdentifier)</_NrRid>
    </PropertyGroup>
  </Target>

  <Target Name="BuildNativeRunnerCore" DependsOnTargets="BuildNativeRunner" BeforeTargets="CopyNativeRunner">
    <!-- NativeRunner is net8.0; do not inherit net8.0-windows from this WPF project. -->
    <PropertyGroup>
      <_NrMsBuildProps>Configuration=$(Configuration);TargetFramework=net8.0;TargetFrameworks=</_NrMsBuildProps>
    </PropertyGroup>
    <MSBuild Condition="'$(_NrRid)' != ''"
             Projects="$(_NativeRunnerProj)"
             Targets="Publish"
             Properties="$(_NrMsBuildProps);RuntimeIdentifier=$(_NrRid);SelfContained=$(_NrSelfContained);PublishProfile=;PublishDir=$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\TAE32.LLVirtualTest.NativeRunner\bin\$(Configuration)\net8.0\$(_NrRid)\native-runner-publish\'))" />
    <MSBuild Condition="'$(_NrRid)' == ''"
             Projects="$(_NativeRunnerProj)"
             Targets="Build"
             Properties="$(_NrMsBuildProps)" />
  </Target>

  <!-- Copy out-of-process native harness runner beside the WPF app (AVE isolation). -->
  <Target Name="CopyNativeRunner" AfterTargets="Build;Publish" DependsOnTargets="BuildNativeRunnerCore">
    <PropertyGroup>
      <_NativeRunnerOut Condition="'$(_NrRid)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\TAE32.LLVirtualTest.NativeRunner\bin\$(Configuration)\net8.0\'))</_NativeRunnerOut>
      <_NativeRunnerOut Condition="'$(_NrRid)' != ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\TAE32.LLVirtualTest.NativeRunner\bin\$(Configuration)\net8.0\$(_NrRid)\native-runner-publish\'))</_NativeRunnerOut>
      <_CopyDest Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)')">$(PublishDir)</_CopyDest>
      <_CopyDest Condition="'$(_CopyDest)' == ''">$(OutputPath)</_CopyDest>
    </PropertyGroup>
    <ItemGroup>
      <_NativeRunnerFiles Include="$(_NativeRunnerOut)**\*.*" Condition="Exists('$(_NativeRunnerOut)')" />
    </ItemGroup>
    <Copy SourceFiles="@(_NativeRunnerFiles)"
          DestinationFolder="$(_CopyDest)"
          SkipUnchangedFiles="true"
          Condition="'@(_NativeRunnerFiles)' != ''" />
  </Target>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="libclang.runtime.win-x64" Version="18.1.3.2" />
    <PackageReference Include="libClangSharp.runtime.win-x64" Version="18.1.3.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- libclang / SDK are win-x64; aligns with FolderProfile RID -->
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>Assets\App.ico</ApplicationIcon>
    <Product>TAE32 LL Virtual Test</Product>
    <AssemblyTitle>TAE32 LL Virtual Test</AssemblyTitle>
    <Company>Tai-Action</Company>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\App.ico" />
    <None Include="Assets\App.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Single-file publish (FolderProfile): native clang + content beside exe -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

</Project>
