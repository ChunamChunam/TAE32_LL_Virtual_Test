<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TAE32.LLVirtualTest.Core\TAE32.LLVirtualTest.Core.csproj" />
    <ProjectReference Include="..\TAE32.LLVirtualTest.Infrastructure\TAE32.LLVirtualTest.Infrastructure.csproj" />
    <ProjectReference Include="..\TAE32.LLVirtualTest.SDK\TAE32.LLVirtualTest.SDK.csproj" />
    <ProjectReference Include="..\TAE32.LLVirtualTest.NativeRunner\TAE32.LLVirtualTest.NativeRunner.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <!-- Copy out-of-process native harness runner beside the WPF app (AVE isolation). -->
  <Target Name="CopyNativeRunner" AfterTargets="Build">
    <PropertyGroup>
      <_NativeRunnerOut>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\TAE32.LLVirtualTest.NativeRunner\bin\$(Configuration)\net8.0\'))</_NativeRunnerOut>
    </PropertyGroup>
    <ItemGroup>
      <_NativeRunnerFiles Include="$(_NativeRunnerOut)**\*.*" Condition="Exists('$(_NativeRunnerOut)')" />
    </ItemGroup>
    <Copy SourceFiles="@(_NativeRunnerFiles)"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true"
          Condition="'@(_NativeRunnerFiles)' != ''" />
  </Target>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="libclang.runtime.win-x64" Version="18.1.3.2" />
    <PackageReference Include="libClangSharp.runtime.win-x64" Version="18.1.3.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

</Project>
