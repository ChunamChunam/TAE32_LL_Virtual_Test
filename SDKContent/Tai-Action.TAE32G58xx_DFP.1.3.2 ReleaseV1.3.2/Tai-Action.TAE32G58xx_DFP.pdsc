  <!-- boards section (mandatory for Board Support Packs) -->
  <boards>
    <board vendor="Tai-Action" name="TAE32G5800_EVAL_BOARD" revision="V1.0" salesContact="http://www.tai-action.com" orderForm="https://www.tai-micro.com">
      <description>Tai-Action TAE32G5800_EVAL_BOARD Board Description</description>
      <image large="BSP/TAE32G5800_EVAL/Images/TAE32G5800_EVAL_BOARD.png"/>
      <book category="setup"     name="BSP/TAE32G5800_EVAL/Quick_Start/TAE32G5800_EVAL_Board_Quick_Start.pdf" title="Getting Started"/>
      <book category="schematic" name="BSP/TAE32G5800_EVAL/Schematic/TAE32G4_EVAL_BOARD_20210917_V1.0_SCH_PCB.pdf" title="Schematics"/>
      <!-- <book category="manual"    name="BSP/TAE32G5800_EVAL/TAE32G5800_um.pdf" title="User Manual"/> -->
      <mountedDevice    deviceIndex="0" Dvendor="Tai-Action:166" Dname="TAE32G5800"/>
      <compatibleDevice deviceIndex="0" Dvendor="Tai-Action:166" DsubFamily="TAE32G58xx"/>
      <feature type="PWR"       n="5"              name="USB Powered"/>
      <feature type="PWR"       n="5"              name="Power Adapter"/>
      <feature type="LED"       n="5"              name="User LEDs"/>
      <feature type="DIO"       n="49"/>
      <feature type="USB"       n="1"/>
      <feature type="XTAL"      n="8000000"/>
      <feature type="I2C"       n="1"/>
      <!--feature type="RS485"     n="1"/-->
      <feature type="CAN"       n="1"/>
      <feature type="Button"    n="4"/>
      <debugInterface connector="JTAG"/>
    </board>
  </boards>


