<?xml version="1.0" encoding="utf-8"?>

<package schemaVersion="1.4" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="PACK.xsd">
  <vendor>Tai-Action</vendor>
  <name>TAE32G58xx_DFP</name>
  <description>Device Family Pack For Tai-Action TAE32 Series</description>
  <url>https://www.keil.com/pack/</url>
  <supportContact>http://www.tai-action.com</supportContact>
  <supportContact>https://www.tai-micro.com</supportContact>
  <!-- optional license file -->
  <!--
  <license>
  </license>
  -->

  <releases>
    <release version="1.3.2" date="2026-06-09">
		Update to match V1.3.2 SDK Release.
	</release>
  </releases>

  <keywords>
    <!-- keywords for indexing -->
    <keyword>Tai-Action</keyword>
    <keyword>TAE</keyword>
    <keyword>TAE32</keyword>
    <keyword>TAE32G58xx</keyword>
    <keyword>Device Support</keyword>
    <keyword>Device Family Package Tai-Action</keyword>
  </keywords>

  <taxonomy>
    <description Cclass="TAE Device">TAE Device System and Startup</description>
    <description Cclass="TAE Drivers">TAE LL Module Drivers</description>
    <description Cclass="TAE Middlewares">TAE Middlewares Drivers</description>
    <description Cclass="TAE Utilities">TAE Utilities Drivers</description>
  </taxonomy>

  <!-- devices section (mandatory for Device Family Packs) -->
  <devices>
    <family Dfamily="TAE32 Series" Dvendor="Tai-Action:166">
      <processor Dcore="Cortex-M4" DcoreVersion="r0p1" Dfpu="1" Dmpu="0" Dendian="Little-endian"/>
      <debug svd="SVD/TAE32G58xx.svd"/>
      <description>
        The TAE32 Series device family contains an ARM Cortex-M4 processor, running up to 200 MHz with a versatile set of on-chip peripherals.
      </description>
      <!-- ************************  Subfamily 'TAE32G58xx'  **************************** -->
      <subFamily DsubFamily="TAE32G58xx">
        <processor  Dclock="200000000"/>
        <!-- *************************  Device 'TAE32G5800'  ***************************** -->
        <device Dname="TAE32G5800">
          <!-- Memory Map -->
          <memory     id="IROM1"                      start="0x08000000"  size="0x40000"    startup="1"   default="1"/>
          <!--memory     id="IROM2"                      start="0x18000000"  size="0x6000"    startup="0"   default="0"/-->
          <memory     id="IRAM1"                      start="0x20000000"  size="0x10000"    uninit ="0"   default="1"/>
          <memory     id="IRAM2"                      start="0x20010000"  size="0x10000"    uninit ="0"   default="0"/>
          <!-- Debug port -->
          <debugconfig default="swd" clock="5000000">
            <swj>1</swj>
          </debugconfig>
          <!-- Flash Download Algorithm -->
          <algorithm name="Flash/TAE32G58xx_128kB.FLM" start="0x08000000" size="0x20000" RAMstart="0x20000000" RAMsize="0x8000" default="0"/>
          <algorithm name="Flash/TAE32G58xx_256kB.FLM" start="0x08000000" size="0x40000" RAMstart="0x20000000" RAMsize="0x8000" default="1"/>
        </device>
      </subFamily>
    </family>
  </devices>


  <!-- conditions section (optional for all Software Packs)-->
  <conditions>
    <condition id="TAE32 CMSIS-CORE">
      <!-- conditions selecting Devices -->
      <description>Tai-Action TAE32 Series devices and CMSIS-CORE</description>
      <!--require Cclass="CMSIS" Cgroup="CORE"/-->
      <require Dvendor="Tai-Action:166" Dname="TAE32*"/>
    </condition>
    <condition id="Startup ARM">
      <description>Startup assembler file for ARMCC</description>
      <require Tcompiler="ARMCC"/>
    </condition>
    <condition id="Startup GCC">
      <description>Startup assembler file for GCC</description>
      <require Tcompiler="GCC"/>
    </condition>
    <condition id="Startup IAR">
      <description>Startup assembler file for IAR</description>
      <require Tcompiler="IAR"/>
    </condition>
  </conditions>


  <!-- component section (optional for all Software Packs)-->
  <components>
    <!-- TAE32G58xx Device Startup Config-->
    <component Cclass="Device" Cgroup="Startup" Cversion="1.0.0" Condition="TAE32 CMSIS-CORE">
      <description>Empty Startup for TAE32G58xx</description>
    </component> 

    <!-- TAE32G58xx Startup Config-->
    <component Cclass="TAE Device" Cgroup="TAE32G58xx" Csub="Startup" Cversion="1.0.0" condition="TAE32 CMSIS-CORE">
      <description>System and Startup for TAE32G58xx</description>
      <files>
        <!-- include folder -->
        <file category="include" name="SDK/Drivers/TAE32G58xx_Device/Inc/"/>

        <!-- startup file -->
        <file category="source"  name="SDK/Drivers/TAE32G58xx_Device/Src/startup_tae32g58xx.c" condition="Startup ARM" version="1.0.0"/>
        <file category="source"  name="SDK/Drivers/TAE32G58xx_Device/Src/startup_tae32g58xx.c" condition="Startup GCC" version="1.0.0"/>
        <file category="source"  name="SDK/Drivers/TAE32G58xx_Device/Src/startup_tae32g58xx.c" condition="Startup IAR" version="1.0.0"/>

        <!--  header file -->
        <file category="header"  name="SDK/Drivers/TAE32G58xx_Device/Inc/tae32g58xx.h" version="1.0.0"/>

        <!-- system file -->
        <file category="source"  name="SDK/Drivers/TAE32G58xx_Device/Src/system_tae32g58xx.c"  version="1.0.0"/>
      </files>
    </component>


    <!-- TAE32G58xx Driver Config-->
    <component Cclass="TAE Drivers" Cgroup="TAE32G58xx" Csub="LL" Cversion="1.0.0" condition="TAE32 CMSIS-CORE">
