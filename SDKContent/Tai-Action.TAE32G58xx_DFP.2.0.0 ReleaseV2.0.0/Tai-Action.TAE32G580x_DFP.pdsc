  <!-- examples section (optional for all Software Packs)-->
  <examples>
    <example name="ProjectTemplateHAL" doc="readme.md" folder="SDK/ProjectTemplateHAL">
      <description>TAE32G580x HAL Template example</description>
      <board name="TAE32G5800_EVAL_BOARD" vendor="Tai-Action"/>
      <project>
        <environment name="uv" load="Project/MDK/ProjectTemplateHAL.uvprojx"/>
      </project>
      <attributes>
        <!--component Cclass="CMSIS"      Cgroup="CORE"/>
        <component Cclass="TAE Device" Cgroup="TAE32G580x"/-->
      </attributes>
    </example>

    <example name="ProjectTemplateLL" doc="readme.md" folder="SDK/ProjectTemplateLL">
      <description>TAE32G580x LL Template example</description>
      <board name="TAE32G5800_EVAL_BOARD" vendor="Tai-Action"/>
