        <environment name="uv" load="Project/MDK/ProjectTemplateLL.uvprojx"/>
      </project>
      <attributes>
        <!--component Cclass="CMSIS"      Cgroup="CORE"/>
        <component Cclass="TAE Device" Cgroup="TAE32G580x"/-->
      </attributes>
    </example>


  </examples>

