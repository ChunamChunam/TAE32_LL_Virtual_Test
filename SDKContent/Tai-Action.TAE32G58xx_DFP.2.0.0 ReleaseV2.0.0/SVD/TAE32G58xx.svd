						<field>
							<name>TXPR</name>
							<description>端点0 TX准备就绪（Endpoint 0 TX Ready）</description>
							<bitRange>[17:17]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>RXPR</name>
							<description>端点0 RX准备就绪（Endpoint 0 RX Ready）</description>
							<bitRange>[16:16]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>TXMAXP</name>
							<description>端点TX最大数据量（Endpoint TX Max Data Number）</description>
