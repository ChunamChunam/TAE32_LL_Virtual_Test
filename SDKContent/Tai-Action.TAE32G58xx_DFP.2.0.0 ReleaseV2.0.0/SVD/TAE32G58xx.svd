					<size>32</size>
					<access>read-write</access>
					<resetValue>0x00000000</resetValue>
					<resetMask>0xFFFFFFFF</resetMask>
					<fields>
						<field>
							<name>AUTOSET</name>
							<description>端点n自动设置使能（Auto Set Enable）</description>
