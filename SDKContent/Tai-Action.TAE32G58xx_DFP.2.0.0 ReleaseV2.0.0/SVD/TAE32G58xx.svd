						<field>
							<name>MODE</name>
							<description>端点n方向模式选择（Endpoint Direction Select）</description>
							<bitRange>[29:29]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>FRCDATTOG</name>
							<description>端点n强制数据切换（Force Data Toggle）</description>
							<bitRange>[27:27]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>CLRDT</name>
							<description>端点n清除数据切换（Clear Data Toggle）</description>
							<bitRange>[22:22]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>SENTSTA</name>
							<description>端点n发送完STALL（Send STALL End）</description>
							<bitRange>[21:21]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>SENDSTA</name>
							<description>端点n发送STALL（Send STALL）</description>
							<bitRange>[20:20]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>FLFIFO</name>
							<description>端点n FIFO刷新使能（Flush FIFO Enable）</description>
							<bitRange>[19:19]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>UNRUN</name>
							<description>端点n欠限（Underrun）</description>
							<bitRange>[18:18]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>FIFONE</name>
							<description>端点n FIFO非空（FIFO Not Empty）</description>
							<bitRange>[17:17]</bitRange>
							<access>read-only</access>
						</field>
						<field>
							<name>TXPR</name>
							<description>端点n TX准备就绪（Endpoint n TX Ready）</description>
							<bitRange>[16:16]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>TXMAXP</name>
							<description>端点TX最大数据量（Endpoint TX Max Data Number）</description>
							<bitRange>[15:0]</bitRange>
							<access>read-write</access>
						</field>
					</fields>
				</register>
				<register>
					<name>RXCTRL</name>
					<description>USB RX Endpoint Control Register</description>
					<addressOffset>0x14</addressOffset>
					<size>32</size>
					<access>read-write</access>
					<resetValue>0x00000000</resetValue>
					<resetMask>0xFFFFFFFF</resetMask>
					<fields>
						<field>
							<name>AUTOCLR</name>
							<description>自动清除使能（Auto Clear Enable）</description>
							<bitRange>[31:31]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>ISO</name>
							<description>ISO传输使能（ISO Transfer Enable）</description>
							<bitRange>[30:30]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>INCRX</name>
							<description>接收不完整数据包指示（Incomplete Data Flag）</description>
							<bitRange>[24:24]</bitRange>
							<access>read-only</access>
						</field>
						<field>
							<name>CDATTOG</name>
							<description>清除数据切换（Clear Data Toggle）</description>
							<bitRange>[23:23]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>SENTSTA</name>
							<description>发送完Stall标志（Sent Stall Flag）</description>
							<bitRange>[22:22]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>SENDSTA</name>
							<description>发送Stall使能（Send Stall Enable）</description>
							<bitRange>[21:21]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>FLFIFO</name>
							<description>FIFO刷新使能（Flush FIFO Enable） </description>
							<bitRange>[20:20]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>DATAERR</name>
							<description>数据包错误（Data Error Flag）</description>
							<bitRange>[19:19]</bitRange>
							<access>read-only</access>
						</field>
						<field>
							<name>OVERRUN</name>
							<description>RXFIFO溢出（RXFIFO Overrun）</description>
							<bitRange>[18:18]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>FIFOFULL</name>
							<description>FIFO满标志（FIFO Full Flag）</description>
							<bitRange>[17:17]</bitRange>
							<access>read-only</access>
						</field>
						<field>
							<name>RXPR</name>
							<description>端点RX准备就绪（Endpoint  RX Ready）</description>
							<bitRange>[16:16]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>RXMAXP</name>
							<description>端点RX最大数据量（Endpoint RX Max Data Number）</description>
							<bitRange>[15:0]</bitRange>
							<access>read-write</access>
						</field>
					</fields>
				</register>
				<register>
					<name>RXCOUNT</name>
					<description>USB Number of bytes to be read from RX endpoint FIFO</description>
					<addressOffset>0x18</addressOffset>
					<size>32</size>
					<access>read-write</access>
					<resetValue>0x00000000</resetValue>
					<resetMask>0xFFFFFFFF</resetMask>
					<fields>
						<field>
							<name>RXCOUNT</name>
							<description>收到的数据字节数（RX Data Count）</description>
							<bitRange>[13:0]</bitRange>
							<access>read-only</access>
						</field>
					</fields>
				</register>
				<register>
					<name>FIFOSIZE</name>
					<description>USB Returns the configured size of the selected RX FIFO and TX FIFOs</description>
					<addressOffset>0x1C</addressOffset>
					<size>32</size>
					<access>read-write</access>
					<resetValue>0x00000000</resetValue>
					<resetMask>0xFFFFFFFF</resetMask>
					<fields>
						<field>
							<name>RXFIFOSIZE</name>
							<description>RXFIFO大小（RXFIFO Size）</description>
							<bitRange>[31:28]</bitRange>
							<access>read-only</access>
						</field>
						<field>
							<name>TXFIFOSIZE</name>
							<description>TXFIFO大小（TXFIFO Size）</description>
							<bitRange>[27:24]</bitRange>
							<access>read-only</access>
