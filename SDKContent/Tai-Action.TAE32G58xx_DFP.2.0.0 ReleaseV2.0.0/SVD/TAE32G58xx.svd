							<access>read-write</access>
						</field>
						<field>
							<name>FADDR</name>
							<description>设备地址（address of the peripheral）</description>
							<bitRange>[7:0]</bitRange>
							<access>read-write</access>
						</field>
					</fields>
				</register>
				<register>
					<name>INDEX</name>
					<description>USB Index And Frame Number Register</description>
					<addressOffset>0x0C</addressOffset>
					<size>32</size>
					<access>read-write</access>
					<resetValue>0x00000000</resetValue>
					<resetMask>0xFFFFFFFF</resetMask>
					<fields>
						<field>
							<name>INDEX</name>
							<description>端点索引寄存器（Endpoint Index Register）</description>
							<bitRange>[19:16]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>FNUM</name>
							<description>SOF帧号（SOF Frame Number）</description>
							<bitRange>[15:0]</bitRange>
							<access>read-only</access>
						</field>
					</fields>
				</register>
				<register>
					<name>TX0CTRL</name>
					<description>USB TX Endpoint 0 Control Register</description>
					<addressOffset>0x10</addressOffset>
					<size>32</size>
					<access>read-write</access>
					<resetValue>0x00000000</resetValue>
					<resetMask>0xFFFFFFFF</resetMask>
					<fields>
						<field>
							<name>FLFIFO</name>
							<description>端点0 FIFO刷新使能（Flush FIFO Enable）</description>
							<bitRange>[24:24]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>SSECLR</name>
							<description>端点0 SETUPEND位清除（SetupEnd Clear）</description>
							<bitRange>[23:23]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>SRPCLR</name>
							<description>端点0 RXPR清除（RxPktRdy Clear）</description>
							<bitRange>[22:22]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>SENDSTA</name>
							<description>端点0 发送Stall使能（Send Stall Enable）</description>
							<bitRange>[21:21]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>SETUPEND</name>
							<description>端点0 Setup结束标志（Setup Transfer End Flag）</description>
							<bitRange>[20:20]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>DATAEND</name>
							<description>端点0数据结束标志（Last Data End Flag）</description>
							<bitRange>[19:19]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>SENTSTA</name>
							<description>端点0发送完Stall标志（Sent Stall Flag）</description>
							<bitRange>[18:18]</bitRange>
							<access>read-write</access>
