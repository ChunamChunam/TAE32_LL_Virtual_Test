							<bitRange>[1:1]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>EP0INTEN</name>
							<description>EP0INT中断使能（Endpoint 0 Interrupt Enable）</description>
							<bitRange>[0:0]</bitRange>
							<access>read-write</access>
						</field>
					</fields>
				</register>
				<register>
					<name>USBINTREN</name>
