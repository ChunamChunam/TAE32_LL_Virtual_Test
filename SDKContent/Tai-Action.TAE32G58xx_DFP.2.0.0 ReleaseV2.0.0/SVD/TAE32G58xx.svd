		<peripheral>
			<name>TMR3</name>
			<groupName>GPTMRY</groupName>
			<baseAddress>0x4002A000</baseAddress>
			<size>32</size>
			<addressBlock>
				<offset>0</offset>
				<size>0x1000</size>
				<usage>registers</usage>
			</addressBlock>
			<interrupt>
				<name>TMR3</name>
				<description/>
				<value>30</value>
			</interrupt>
			<registers>
				<register>
					<name>CR0</name>
					<description>TMRx Control Register0</description>
					<addressOffset>0x00</addressOffset>
					<size>32</size>
