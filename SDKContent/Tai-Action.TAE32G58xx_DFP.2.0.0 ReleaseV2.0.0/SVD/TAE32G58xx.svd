						<field>
							<name>DPOE_EN</name>
							<description>DP软件输出使能（DP Software Output Enable）</description>
							<bitRange>[28:28]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>DMIE</name>
							<description>DM输入使能（DM Input Enable）</description>
							<bitRange>[27:27]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>DMIE_EN</name>
							<description>DM软件输入使能（DM Software Input Enable）</description>
							<bitRange>[26:26]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>DPIE</name>
							<description>DP输入使能（DP Input Enable）</description>
							<bitRange>[25:25]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>DPIE_EN</name>
							<description>DP软件输入使能（DP Software Input Enable）</description>
							<bitRange>[24:24]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>DMSR</name>
							<description>DM PAD输出slewrate增强使能（DM Output Slewrate Enhancement Enable）</description>
							<bitRange>[23:23]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>DMTRIM</name>
							<description>DM端电阻修调（DM Resistor Trimming）</description>
							<bitRange>[22:20]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>DPSR</name>
							<description>DP PAD输出slewrate增强使能（DP Output Slewrate Enhancement Enable）</description>
							<bitRange>[19:19]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>DPTRIM</name>
							<description>DP端电阻修调（DP Resistor Trimming）</description>
							<bitRange>[18:16]</bitRange>
							<access>read-write</access>
						</field>
