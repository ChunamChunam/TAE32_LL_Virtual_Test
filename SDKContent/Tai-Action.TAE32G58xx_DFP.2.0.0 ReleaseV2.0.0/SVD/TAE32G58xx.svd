							<name>DMPU</name>
							<description>DM上拉使能（DM Pull Up Enable）</description>
							<bitRange>[13:13]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>DMPU_EN</name>
							<description>DM上拉软件使能（DM Software Pull Up Enable）</description>
							<bitRange>[12:12]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>DPPD</name>
							<description>DP下拉使能（DP Pull Down Enable）</description>
							<bitRange>[11:11]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>DPPD_EN</name>
							<description>DP下拉软件使能（DP Software Pull Down Enable）</description>
							<bitRange>[10:10]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>DPPU</name>
							<description>DP上拉使能（DP Pull Up Enable）</description>
							<bitRange>[9:9]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>DPPU_EN</name>
							<description>DP上拉软件使能（DP Software Pull Up Enable）</description>
							<bitRange>[8:8]</bitRange>
							<access>read-write</access>
						</field>
