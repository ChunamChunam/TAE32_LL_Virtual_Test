			<interrupt>
				<name>USB_PWR</name>
				<description/>
				<value>81</value>
			</interrupt>
			<interrupt>
				<name>USB_DET</name>
				<description/>
				<value>82</value>
			</interrupt>
			<interrupt>
				<name>USB_EP</name>
				<description/>
				<value>83</value>
			</interrupt>
			<registers>
				<register>
					<name>CTRL</name>
					<description>USB Control Register Include Address And Power Control</description>
					<addressOffset>0x00</addressOffset>
					<size>32</size>
					<access>read-write</access>
					<resetValue>0x00000000</resetValue>
					<resetMask>0xFFFFFFFF</resetMask>
					<fields>
						<field>
							<name>ISOUP</name>
							<description>ISO更新使能（ISO Upgrade Enable）</description>
							<bitRange>[15:15]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>SCONN</name>
							<description>软件连接使能（Software Connect Enable）</description>
							<bitRange>[14:14]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>RESET</name>
							<description>复位检测信号（Reset Detect Flag）</description>
							<bitRange>[11:11]</bitRange>
							<access>read-only</access>
						</field>
						<field>
							<name>RESUME</name>
							<description>唤醒使能（Resume Enable）</description>
