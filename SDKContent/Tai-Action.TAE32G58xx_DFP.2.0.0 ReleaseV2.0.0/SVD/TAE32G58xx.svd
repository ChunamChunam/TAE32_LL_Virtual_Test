						<field>
							<name>TM1</name>
							<description>测试模式使能</description>
							<bitRange>[1:1]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>PHY_EN</name>
							<description>PHY使能，USB使用就开</description>
							<bitRange>[0:0]</bitRange>
							<access>read-write</access>
						</field>
					</fields>
				</register>
				<register>
					<name>IUINTREN</name>
