							<bitRange>[6:6]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>VBUSVALID</name>
							<description>Vbus高于VBusValid阈值使能</description>
							<bitRange>[5:5]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>AVALID</name>
							<description>Vbus高于Vbus A设备会话阈值使能</description>
							<bitRange>[4:4]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>VBUSLO</name>
							<description>Vbus超过会话结束阈值使能</description>
							<bitRange>[3:3]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>CID</name>
							<description>mini AB连接器ID引脚使能</description>
							<bitRange>[2:2]</bitRange>
