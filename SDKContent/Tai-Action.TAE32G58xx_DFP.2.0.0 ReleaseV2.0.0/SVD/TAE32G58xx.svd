<?xml version="1.0" encoding="UTF-8"?>
<device schemaVersion="1.1" xs:noNamespaceSchemaLocation="CMSIS-SVD.xsd" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance">
	<vendor>ARM Ltd.</vendor>
	<vendorID>ARM</vendorID>
	<name>myChip</name>
	<series>ARMCM3</series>
	<version>1.2</version>
	<description>ARM 32-bit Cortex-M3 Microcontroller based device, CPU clock up to 80MHz, etc.</description>
	<cpu>
		<name>CM3</name>
		<revision>r2p1</revision>
		<endian>little</endian>
		<mpuPresent>false</mpuPresent>
		<fpuPresent>false</fpuPresent>
		<nvicPrioBits>3</nvicPrioBits>
		<vendorSystickConfig>false</vendorSystickConfig>
	</cpu>
	<addressUnitBits>8</addressUnitBits>
	<width>32</width>
	<peripherals>
		<peripheral>
			<name>XIF</name>
			<groupName>XIF</groupName>
			<baseAddress>0x40016000</baseAddress>
			<size>32</size>
			<addressBlock>
				<offset>0</offset>
				<size>0x1000</size>
				<usage>registers</usage>
			</addressBlock>
			<interrupt>
				<name>XIF</name>
				<description/>
				<value>84</value>
			</interrupt>
			<registers>
				<register>
					<name>ENABLE</name>
					<description>XIF Enable Register</description>
					<addressOffset>0x00</addressOffset>
					<size>32</size>
					<access>read-write</access>
					<resetValue>0x00000000</resetValue>
					<resetMask>0xFFFFFFFF</resetMask>
					<fields>
						<field>
							<name>DIR</name>
							<description>XIF传输方向（XIF Transfer Direction）</description>
							<bitRange>[5:5]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>TXDEN</name>
							<description>XIF DMA发送使能（XIF DMA Enable）</description>
							<bitRange>[4:4]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>RELOAD</name>
							<description>重复模式（Reload Mode）</description>
							<bitRange>[3:3]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>SRST</name>
							<description>XIF软复位（XIF Software Reset）</description>
							<bitRange>[2:2]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>DMAEN</name>
							<description>XIF DMA接收使能（XIF DMA Enable）</description>
							<bitRange>[1:1]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>ENABLE</name>
							<description>XIF使能（XIF Enable）</description>
							<bitRange>[0:0]</bitRange>
							<access>read-write</access>
						</field>
					</fields>
				</register>
				<register>
					<name>CTRL</name>
					<description>XIF Control Register</description>
					<addressOffset>0x04</addressOffset>
					<size>32</size>
					<access>read-write</access>
					<resetValue>0x00000000</resetValue>
					<resetMask>0xFFFFFFFF</resetMask>
					<fields>
						<field>
							<name>TXDIE</name>
							<description>TXDI中断使能（XIF Tx Done Interrupt Enable）</description>
							<bitRange>[26:26]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>TXEIE</name>
							<description>TXEI中断使能（TXFIFO Empty Interrupt Enable）</description>
							<bitRange>[24:24]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>TXFTLR</name>
							<description>TXFIFO空中断阈值（TXFIFO Empty Watermark）</description>
							<bitRange>[22:20]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>DCS</name>
							<description>XIF采样时间点延后选择（XIF Delay Chain Select）</description>
							<bitRange>[18:16]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>BTOIE</name>
							<description>BTOI中断使能（XIF Wait BUSY Timeout Interrupt Enable）</description>
							<bitRange>[15:15]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>RXDIE</name>
							<description>RXDI中断使能（XIF Rx Done Interrupt Enable）</description>
							<bitRange>[14:14]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>RXOFIE</name>
							<description>RXOFI中断使能（RXFIFO Overflow Interrupt Enable）</description>
							<bitRange>[13:13]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>RXFIE</name>
							<description>RXFI中断使能（RXFIFO Full Interrupt Enable）</description>
							<bitRange>[12:12]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>RXFTLR</name>
							<description>RXFIFO满中断阈值（RXFIFO Full Watermark）</description>
							<bitRange>[10:8]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>DCNT</name>
							<description>XIF传输数据量（The Count of DATA）</description>
							<bitRange>[7:0]</bitRange>
							<access>read-write</access>
						</field>
					</fields>
				</register>
				<register>
					<name>TIMING</name>
					<description>XIF Timing Register</description>
					<addressOffset>0x08</addressOffset>
					<size>32</size>
					<access>read-write</access>
					<resetValue>0x00000000</resetValue>
					<resetMask>0xFFFFFFFF</resetMask>
					<fields>
						<field>
							<name>RDHTIME</name>
							<description>XIF RD为高的时间长度（The Length Of Time For RD High）</description>
							<bitRange>[31:24]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>RDLTIME</name>
							<description>XIF RD为低的时间长度（The Length Of Time For RD Low）</description>
							<bitRange>[23:16]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>CONLTIME</name>
							<description>XIF CONVST为低的时间长度（The Length Of Time For CONVST Low）</description>
							<bitRange>[15:8]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>RSTTIME</name>
							<description>XIF RESET为高的时间长度（The Length Of Time For RESET High）</description>
							<bitRange>[7:0]</bitRange>
							<access>read-write</access>
						</field>
					</fields>
				</register>
				<register>
					<name>TO</name>
					<description>XIF Timeout Register</description>
					<addressOffset>0x0C</addressOffset>
					<size>32</size>
					<access>read-write</access>
					<resetValue>0x00000000</resetValue>
					<resetMask>0xFFFFFFFF</resetMask>
					<fields>
						<field>
							<name>PTOT</name>
							<description>XIF超时设置（XIF BUSY TIMEOUT Timing）</description>
							<bitRange>[15:0]</bitRange>
							<access>read-write</access>
						</field>
					</fields>
				</register>
				<register>
					<name>DATA</name>
					<description>XIF Read Data Registers</description>
					<addressOffset>0x10</addressOffset>
					<size>32</size>
					<access>read-write</access>
					<resetValue>0x00000000</resetValue>
					<resetMask>0xFFFFFFFF</resetMask>
					<fields>
						<field>
							<name>DATA</name>
							<description>读取数据寄存器（FIFO Read DATA Register）</description>
							<bitRange>[15:0]</bitRange>
							<access>read-only</access>
						</field>
					</fields>
				</register>
				<register>
					<name>ISR</name>
					<description>XIF Interrupt And Status Register</description>
					<addressOffset>0x14</addressOffset>
					<size>32</size>
					<access>read-write</access>
					<resetValue>0x00000000</resetValue>
					<resetMask>0xFFFFFFFF</resetMask>
					<fields>
						<field>
							<name>TFF</name>
							<description>TXFIFO满标志（TXFIFO Full Flag）</description>
							<bitRange>[21:21]</bitRange>
							<access>read-only</access>
						</field>
						<field>
							<name>TFE</name>
							<description>TXFIFO空标志（TXFIFO Empty Flag）</description>
							<bitRange>[20:20]</bitRange>
							<access>read-only</access>
						</field>
						<field>
							<name>TXDI</name>
							<description>XIF发送完成中断（XIF TX Done Interrupt）</description>
							<bitRange>[18:18]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>TXEI</name>
							<description>TXFIFO空中断（TXFIFO Empty Interrupt）</description>
							<bitRange>[16:16]</bitRange>
							<access>read-only</access>
						</field>
						<field>
							<name>TXFLR</name>
							<description>TXFIFO实时剩余数据量（TXFIFO Level Register）</description>
							<bitRange>[15:12]</bitRange>
							<access>read-only</access>
						</field>
						<field>
							<name>RXFLR</name>
							<description>RXFIFO实时剩余数据量（RXFIFO Level Register）</description>
							<bitRange>[11:8]</bitRange>
							<access>read-only</access>
						</field>
						<field>
							<name>FF</name>
							<description>RXFIFO满标志（RXFIFO Full Flag）</description>
							<bitRange>[5:5]</bitRange>
							<access>read-only</access>
						</field>
						<field>
							<name>FE</name>
							<description>RXFIFO空标志（RXFIFO Empty Flag）</description>
							<bitRange>[4:4]</bitRange>
							<access>read-only</access>
						</field>
						<field>
							<name>BTOI</name>
							<description>XIF等待BUSY超时中断（XIF Wait BUSY Timeout Interrupt Enable）</description>
							<bitRange>[3:3]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>RXDI</name>
							<description>XIF接收完成中断（XIF RX Done Interrupt）</description>
							<bitRange>[2:2]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>RXOFI</name>
							<description>RXFIFO上溢中断（RXFIFO Overflow Interrupt）</description>
							<bitRange>[1:1]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>RXFI</name>
							<description>RXFIFO满中断（RXFIFO Full Interrupt）</description>
							<bitRange>[0:0]</bitRange>
							<access>read-only</access>
						</field>
					</fields>
				</register>
				<register>
					<name>WDATA</name>
					<description>XIF Write Data Registers</description>
					<addressOffset>0x18</addressOffset>
					<size>32</size>
					<access>read-write</access>
					<resetValue>0x00000000</resetValue>
					<resetMask>0xFFFFFFFF</resetMask>
					<fields>
						<field>
							<name>WDATA</name>
							<description>写入数据寄存器（FIFO Write DATA Register）</description>
							<bitRange>[15:0]</bitRange>
							<access>read-write</access>
						</field>
					</fields>
				</register>
			</registers>
		</peripheral>
		<peripheral>
			<name>WWDG</name>
			<groupName>WWDG</groupName>
			<baseAddress>0x4000D000</baseAddress>
			<size>32</size>
			<addressBlock>
				<offset>0</offset>
				<size>0x1000</size>
				<usage>registers</usage>
			</addressBlock>
			<interrupt>
				<name>WWDG</name>
				<description/>
				<value>41</value>
			</interrupt>
			<registers>
				<register>
					<name>CR</name>
					<description>WWDG Control Register</description>
					<addressOffset>0x00</addressOffset>
					<size>32</size>
					<access>read-write</access>
					<resetValue>0x00000000</resetValue>
					<resetMask>0xFFFFFFFF</resetMask>
					<fields>
						<field>
							<name>EWIE</name>
							<description>WWDG提前唤醒中断使能位（WWDG Early Wakeup Interrupt Enable）</description>
							<bitRange>[1:1]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>WEN</name>
							<description>WWDG使能位（WWDG Enable）</description>
							<bitRange>[0:0]</bitRange>
							<access>read-write</access>
						</field>
					</fields>
				</register>
				<register>
					<name>WVR</name>
					<description>WWDG Window Register</description>
					<addressOffset>0x04</addressOffset>
					<size>32</size>
					<access>read-write</access>
					<resetValue>0x00000000</resetValue>
					<resetMask>0xFFFFFFFF</resetMask>
					<fields>
						<field>
							<name>WV</name>
							<description>WWDG窗口比较值（WWDG Window Value）</description>
							<bitRange>[15:0]</bitRange>
							<access>read-write</access>
						</field>
					</fields>
				</register>
				<register>
					<name>CVR</name>
					<description>WWDG Counter Register</description>
					<addressOffset>0x08</addressOffset>
					<size>32</size>
					<access>read-write</access>
					<resetValue>0x00000000</resetValue>
					<resetMask>0xFFFFFFFF</resetMask>
					<fields>
						<field>
							<name>CV</name>
							<description>WWDG递减计数值（WWDG Counter Value）</description>
							<bitRange>[15:0]</bitRange>
							<access>read-write</access>
						</field>
					</fields>
				</register>
				<register>
					<name>PSCR</name>
					<description>WWDG Prescaler Register</description>
					<addressOffset>0x0C</addressOffset>
					<size>32</size>
					<access>read-write</access>
					<resetValue>0x00000000</resetValue>
					<resetMask>0xFFFFFFFF</resetMask>
					<fields>
						<field>
							<name>PSC</name>
							<description>WWDG预分频器（WWDG Prescaler divider）</description>
							<bitRange>[15:0]</bitRange>
							<access>read-write</access>
						</field>
					</fields>
				</register>
				<register>
					<name>ISR</name>
					<description>WWDG Status Register</description>
					<addressOffset>0x10</addressOffset>
					<size>32</size>
					<access>read-write</access>
					<resetValue>0x00000000</resetValue>
					<resetMask>0xFFFFFFFF</resetMask>
					<fields>
						<field>
							<name>EWIF</name>
							<description>WWDG提前唤醒中断标志位（WWDG Early Wakeup Interrupt Flag）</description>
							<bitRange>[0:0]</bitRange>
							<access>read-write</access>
						</field>
					</fields>
				</register>
			</registers>
		</peripheral>
		<peripheral>
			<name>USB</name>
			<groupName>USB</groupName>
			<baseAddress>0x40035000</baseAddress>
			<size>32</size>
			<addressBlock>
				<offset>0</offset>
				<size>0x1000</size>
				<usage>registers</usage>
