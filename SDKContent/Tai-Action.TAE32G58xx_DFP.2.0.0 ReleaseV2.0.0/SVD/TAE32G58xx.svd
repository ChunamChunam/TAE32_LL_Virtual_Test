							<bitRange>[18:18]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>EP1RXINTEN</name>
							<description>EP1RXINT中断使能（Endpoint 1 RX Interrupt Enable）</description>
							<bitRange>[17:17]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>EP2TXINTEN</name>
							<description>EP2TXINT中断使能（Endpoint 2 TX Interrupt Enable）</description>
							<bitRange>[2:2]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>EP1TXINTEN</name>
