				<register>
					<name>FIFOSZ</name>
					<description>The Dynamic FIFO registers</description>
					<addressOffset>0x60</addressOffset>
					<size>32</size>
					<access>read-write</access>
					<resetValue>0x00000000</resetValue>
					<resetMask>0xFFFFFFFF</resetMask>
					<fields>
						<field>
							<name>RXDPB</name>
							<description>RX端点双数据包缓冲使能（RX Endpoint Double Packet Buffer Enable）</description>
							<bitRange>[28:28]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>RXSZ</name>
							<description>RX端点最大数据包大小（RX Endpoint Maximum Packet Size）</description>
							<bitRange>[27:24]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>TXDPB</name>
							<description>TX端点双数据包缓冲使能（TX Endpoint Double Packet Buffer Enable）</description>
							<bitRange>[20:20]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>TXSZ</name>
							<description>TX端点最大数据包大小（TX Endpoint Maximum Packet Size）</description>
							<bitRange>[19:16]</bitRange>
							<access>read-write</access>
						</field>
					</fields>
				</register>
				<register>
					<name>FIFOAD</name>
